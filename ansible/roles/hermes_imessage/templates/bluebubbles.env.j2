# Managed by ~/src/profile Ansible role: hermes_imessage
# Machine-local secret file. Do not commit. Mode should be 0600.
BLUEBUBBLES_SERVER_URL={{ profile_hermes_imessage_server_url | quote }}
BLUEBUBBLES_PASSWORD={{ profile_hermes_imessage_password_resolved | quote }}
BLUEBUBBLES_WEBHOOK_HOST={{ profile_hermes_imessage_webhook_host | quote }}
BLUEBUBBLES_WEBHOOK_PORT={{ profile_hermes_imessage_webhook_port | string | quote }}
BLUEBUBBLES_WEBHOOK_PATH={{ profile_hermes_imessage_webhook_path | quote }}
BLUEBUBBLES_ALLOW_ALL_USERS={{ (profile_hermes_imessage_allow_all_users | bool) | ternary('true', 'false') | quote }}
{% if profile_hermes_imessage_allowed_users | length > 0 %}
BLUEBUBBLES_ALLOWED_USERS={{ profile_hermes_imessage_allowed_users | join(',') | quote }}
{% endif %}
BLUEBUBBLES_REQUIRE_MENTION={{ (profile_hermes_imessage_require_mention | bool) | ternary('true', 'false') | quote }}
{% if profile_hermes_imessage_mention_patterns | length > 0 %}
BLUEBUBBLES_MENTION_PATTERNS={{ profile_hermes_imessage_mention_patterns | to_json | quote }}
{% endif %}
{% if profile_hermes_imessage_home_channel | length > 0 %}
BLUEBUBBLES_HOME_CHANNEL={{ profile_hermes_imessage_home_channel | quote }}
{% endif %}
