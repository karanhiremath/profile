{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": ["rustc@1.85", "cargo@1.85", "just@latest", "gh@latest"],
  "shell": {
    "init_hook": [
      "echo aos portable build box — rustc/cargo/just/gh"
    ],
    "scripts": {
      "build": "cargo build --release --manifest-path bin/aos-buf/Cargo.toml --bin aos",
      "test": "cargo test --manifest-path bin/aos-buf/Cargo.toml",
      "install": "bin/aos-buf/install --from-source"
    }
  }
}
