#!/bin/bash
# Vorssaint - free, open-source macOS menu bar toolkit
# https://github.com/vorssaintapp/vorssaint-utils (GPL-3.0-or-later)
#
# Usage: install [--help]

set -euo pipefail

shopt -s failglob

usage() {
    sed -n '2,5p' "$0" | sed 's/^# //; s/^#$//'
}

case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
esac

# Set PROFILE_DIR and APP_BIN if not already set
if [ -z "${PROFILE_DIR:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export PROFILE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi

if [ -z "${APP_BIN:-}" ]; then
    export APP_BIN="${PROFILE_DIR}/bin"
fi

. "${APP_BIN}/sh/shell_fns" --source-only
. "${APP_BIN}/sh/brew_helper.sh"

app_name="vorssaint"

MACHINE="$(uname -s)"

# Check if already installed (macOS only)
if [[ "${MACHINE}" == "Darwin" ]] && [ -d "/Applications/Vorssaint.app" ]; then
    echo "Vorssaint already installed. Checking for updates..."
    ensure_brew_in_path || {
        echo "ERROR: Homebrew not found. Please install Homebrew first."
        exit 1
    }
    brew upgrade --cask vorssaint || echo "Vorssaint is already up to date"
    exit 0
fi

install_messages "start" "$app_name"

case "${MACHINE}" in
    Darwin)
        echo "Installing Vorssaint on Mac..."
        ensure_brew_in_path || {
            echo "ERROR: Homebrew not found. Please install Homebrew first."
            exit 1
        }
        brew install --cask vorssaint
        ;;
    Linux)
        echo "Vorssaint is only available on macOS."
        echo "Skipping installation on Linux."
        exit 0
        ;;
    *)
        echo "Unsupported platform: ${MACHINE}"
        exit 1
        ;;
esac

install_messages "end" "$app_name"

echo ""
echo "Vorssaint installed successfully!"
echo "Launch Vorssaint from Applications, pick a feature bundle, and grant the permissions it asks for."
echo ""
