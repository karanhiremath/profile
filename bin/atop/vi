#!/usr/bin/env bash
# Coordinate via a live nvim prompt buffer. Never tmux send-keys.
# Usage: atop vi [session-id] [list|get|set]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: atop vi | a-top vi | bin/atop/vi [open|list|catalog|get|set|tty|jobs] [session-id] [--file PATH]

Default (no args): open a NEW nvim with a coordinator buffer + telescope
menu of prompt buffers from every harness (herm, pi, claude, codex, cursor, …).
Never send-keys. Prompt text is file/JSON data, not interpolated into Lua.

  open                 new nvim + telescope (default; needs a TTY)
  tty                  same picker, captured on a PTY (agent eval)
  list                 print harness catalog
  catalog              write catalog JSON to stdout
  <id>                 same as: <id> get
  <id> set --file PATH queue write (default; job JSON on stdout)
  <id> set --wait --file PATH
                       block until write completes
  jobs                 list background set jobs (JSON)
  job <id>             one job receipt + result (JSON)
  <id> snapshot        JSON snapshot (pid, path, sha256, lines)

<id> matches herm-<ms>, pi-editor prompt, claude-prompt-*, basename, path, or nvim pid.
set is backgrounded so the caller can continue while nvim finishes :write.
EOF
}

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
HELPER="$SCRIPT_DIR/vi-request.lua"
CATALOG_PY="$SCRIPT_DIR/catalog.py"
NVIM_BIN="${NVIM_BIN:-nvim}"
PROFILE_BIN="$(cd -P "$SCRIPT_DIR/.." && pwd)"

die() { printf 'atop-vi: %s\n' "$*" >&2; exit 1; }

resolve_aos_buf() {
  if [[ -n "${AOS_BUF:-}" && -x "${AOS_BUF}" ]]; then
    printf '%s\n' "$AOS_BUF"
    return 0
  fi
  local cand
  for cand in \
    "$PROFILE_BIN/aos-buf/target/debug/aos-buf" \
    "$PROFILE_BIN/aos-buf/target/release/aos-buf" \
    "${HOME}/.local/bin/aos-buf"
  do
    if [[ -x "$cand" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  command -v aos-buf
}

[[ -f "$HELPER" ]] || die "missing helper $HELPER"
command -v "$NVIM_BIN" >/dev/null || die "nvim not on PATH"

SESSION=""
OP="open"
FILE=""
WAIT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    --file)
      [[ $# -ge 2 ]] || die "--file needs a path"
      FILE="$2"
      shift 2
      ;;
    --wait)
      WAIT=1
      shift
      ;;
    --background|--bg)
      WAIT=0
      shift
      ;;
    list|get|set|snapshot|open|catalog|tty|jobs|job|status)
      OP="$1"
      shift
      ;;
    --internal-job-set)
      OP="internal-job-set"
      shift
      ;;
    *)
      if [[ -z "$SESSION" ]]; then
        SESSION="$1"
        shift
        [[ "$OP" == open ]] && OP=get
      else
        die "unknown argument: $1"
      fi
      ;;
  esac
done

if [[ "$OP" == set && -z "$FILE" ]]; then
  die "set requires --file PATH"
fi
if [[ "$OP" == job || "$OP" == status ]]; then
  [[ -n "$SESSION" ]] || die "job id required"
fi
if [[ "$OP" != list && "$OP" != open && "$OP" != catalog && "$OP" != tty && "$OP" != jobs && "$OP" != job && "$OP" != status && "$OP" != internal-job-set && -z "$SESSION" ]]; then
  die "session id required for $OP"
fi
if [[ -n "$FILE" && "$FILE" != /* ]]; then
  FILE="$(pwd)/$FILE"
fi
if [[ "$OP" == set && -z "$WAIT" ]]; then
  if [[ -n "${ATOP_VI_WAIT:-}" ]]; then
    WAIT=1
  else
    WAIT=0
  fi
fi

if [[ -z "${ATOP_VI_LEGACY:-}" ]] && AOS_BUF_BIN="$(resolve_aos_buf)"; then
  case "$OP" in
    catalog) exec "$AOS_BUF_BIN" catalog ;;
    list)
      if [[ -z "$SESSION" ]]; then
        exec "$AOS_BUF_BIN" list
      fi
      ;;
    get|snapshot) exec "$AOS_BUF_BIN" "$OP" "$SESSION" ;;
    set)
      set_args=("$SESSION")
      [[ "$WAIT" == 1 ]] && set_args+=(--wait)
      exec "$AOS_BUF_BIN" set "${set_args[@]}" --file "$FILE"
      ;;
    jobs) exec "$AOS_BUF_BIN" jobs ;;
    job|status) exec "$AOS_BUF_BIN" job "$SESSION" ;;
  esac
fi

TMPDIR_REAL="${TMPDIR:-/tmp}"

job_root() {
  printf '%s\n' "${ATOP_VI_JOBDIR:-${TMPDIR_REAL%/}/atop-vi.jobs.${USER}}"
}

rpc() {
  local sock="$1" req="$2"
  # Vim list ['a','b'] — not a dict. Paths are data; never interpolate prompt text.
  "$NVIM_BIN" --server "$sock" --remote-expr \
    "luaeval(\"dofile(_A[1]).request(_A[2])\", ['${HELPER}', '${req}'])"
}

write_job_json() {
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" <<'PY'
import json, sys, time
path, job_id, status, pid, session, buf_path, src, sock = sys.argv[1:9]
rec = {
    "schema": "atop-vi.job.v1",
    "id": job_id,
    "status": status,
    "op": "set",
    "pid": int(pid) if pid and pid.lstrip("-").isdigit() else None,
    "session": session,
    "path": buf_path,
    "file": src,
    "socket": sock,
    "job_dir": path.rsplit("/", 1)[0] if path.endswith("/job.json") else path,
    "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}
if path.endswith("/job.json"):
    rec["job_dir"] = path[: -len("/job.json")]
open(path, "w").write(json.dumps(rec) + "\n")
PY
}

print_job() {
  python3 - "$1" <<'PY'
import json, os, sys
job_dir = sys.argv[1]
meta_path = os.path.join(job_dir, "job.json")
if not os.path.isfile(meta_path):
    raise SystemExit(f"atop-vi: no job {os.path.basename(job_dir)}")
rec = json.loads(open(meta_path).read())
result_path = os.path.join(job_dir, "result.json")
pid_path = os.path.join(job_dir, "pid")
alive = False
pid = rec.get("pid")
if os.path.isfile(pid_path):
    try:
        pid = int(open(pid_path).read().strip())
        rec["pid"] = pid
    except ValueError:
        pass
if isinstance(pid, int) and pid > 0:
    try:
        os.kill(pid, 0)
        alive = True
    except OSError:
        alive = False
if os.path.isfile(result_path) and os.path.getsize(result_path) > 0:
    result = json.loads(open(result_path).read())
    rec["result"] = result
    rec["status"] = result.get("status") or rec.get("status")
elif alive:
    rec["status"] = "running"
else:
    rec["status"] = rec.get("status") or "error"
    if rec["status"] == "running":
        rec["status"] = "error"
        rec["error"] = "worker exited without a result"
print(json.dumps(rec, indent=2))
PY
}

print_jobs() {
  python3 - "$(job_root)" <<'PY'
import json, os, sys
root = sys.argv[1]
out = {"schema": "atop-vi.jobs.v1", "jobs": []}
if os.path.isdir(root):
    for name in sorted(os.listdir(root)):
        meta = os.path.join(root, name, "job.json")
        if not os.path.isfile(meta):
            continue
        rec = json.loads(open(meta).read())
        result_path = os.path.join(root, name, "result.json")
        pid_path = os.path.join(root, name, "pid")
        pid = rec.get("pid")
        if os.path.isfile(pid_path):
            try:
                pid = int(open(pid_path).read().strip())
            except ValueError:
                pass
        alive = False
        if isinstance(pid, int) and pid > 0:
            try:
                os.kill(pid, 0)
                alive = True
            except OSError:
                alive = False
        if os.path.isfile(result_path) and os.path.getsize(result_path) > 0:
            result = json.loads(open(result_path).read())
            status = result.get("status") or "ok"
        elif alive:
            status = "running"
        else:
            status = "error"
        out["jobs"].append({
            "id": rec.get("id") or name,
            "status": status,
            "pid": pid,
            "path": rec.get("path"),
            "file": rec.get("file"),
            "job_dir": rec.get("job_dir") or os.path.join(root, name),
        })
print(json.dumps(out, indent=2))
PY
}

do_set_rpc() {
  local reqdir="$1" sock="$2" path_buf="$3" buf="$4" src="$5" expected_pid="$6"
  local req="$reqdir/write-req.json" out="$reqdir/write-out.json"
  python3 - "$req" "$out" "$path_buf" "$buf" "$src" "$expected_pid" <<'PY'
import json, sys
req, out, path, buf, file, pid = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5], int(sys.argv[6])
json.dump({
    "op": "write",
    "path": path,
    "buffer": buf,
    "file": file,
    "expected_pid": pid,
    "output_path": out,
}, open(req, "w"))
open(req, "a").write("\n")
PY
  # write-out is reserved with wx by the lua helper; must not pre-exist.
  rm -f "$out"
  rpc "$sock" "$req" >/dev/null
  python3 - "$out" "$reqdir/result.json" <<'PY'
import json, sys
out, result_path = sys.argv[1], sys.argv[2]
try:
    rec = json.loads(open(out).read())
except Exception as exc:
    rec = {"status": "error", "error": f"missing write receipt: {exc}"}
if rec.get("status") == "error":
    open(result_path, "w").write(json.dumps(rec) + "\n")
    raise SystemExit(rec.get("error") or "write failed")
rec["status"] = rec.get("status") or "ok"
open(result_path, "w").write(json.dumps(rec) + "\n")
print(f"wrote {rec.get('path')} pid={rec.get('pid')} buf={rec.get('buffer')} sha256={rec.get('sha256')}")
PY
}

if [[ "$OP" == jobs ]]; then
  print_jobs
  exit 0
fi
if [[ "$OP" == job || "$OP" == status ]]; then
  print_job "$(job_root)/$SESSION"
  exit 0
fi

if [[ "$OP" == internal-job-set ]]; then
  REQDIR="${ATOP_VI_JOB_DIR:?}"
  do_set_rpc "$REQDIR" "${ATOP_VI_SOCK:?}" "${ATOP_VI_PATH:?}" "${ATOP_VI_BUF:?}" "${ATOP_VI_FILE:?}" "${ATOP_VI_PID:?}" \
    >"$REQDIR/stdout" || true
  if [[ ! -s "$REQDIR/result.json" ]]; then
    printf '%s\n' '{"status":"error","error":"worker exited without a result"}' >"$REQDIR/result.json"
  fi
  exit 0
fi

REQDIR="$(mktemp -d "${TMPDIR_REAL%/}/atop-vi.XXXXXX")"
chmod 700 "$REQDIR"
cleanup() { rm -rf "$REQDIR"; }
trap cleanup EXIT

owner_ok() {
  local sock="$1" dir mode
  dir="$(dirname "$sock")"
  [[ -S "$sock" && -O "$sock" && -O "$dir" ]] || return 1
  mode="$(stat -f '%OLp' "$dir" 2>/dev/null || stat -c '%a' "$dir")"
  [[ "$mode" == "700" ]]
}

list_sockets() {
  local root
  for root in \
    "${TMPDIR_REAL%/}/nvim.${USER}" \
    "/var/folders/"*/*/*/T/nvim.${USER} \
    "/private/var/folders/"*/*/*/T/nvim.${USER}
  do
    [[ -d "$root" ]] || continue
    find "$root" -name 'nvim.*' -type s 2>/dev/null || true
  done
}

# Collect socket inventory
INVENTORY="$REQDIR/inventory.jsonl"
: > "$INVENTORY"
while IFS= read -r sock; do
  [[ -n "$sock" ]] || continue
  owner_ok "$sock" || continue
  req="$REQDIR/list-$(basename "$(dirname "$sock")").json"
  out="$REQDIR/list-$(basename "$(dirname "$sock")").out.json"
  python3 - "$req" "$out" <<'PY'
import json, sys
json.dump({"op": "list", "output_path": sys.argv[2]}, open(sys.argv[1], "w"))
open(sys.argv[1], "a").write("\n")
PY
  if ! expr_out="$(rpc "$sock" "$req" 2>/dev/null)"; then
    continue
  fi
  python3 - "$sock" "$out" "$INVENTORY" <<'PY'
import json, sys
sock, outp, inv = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    rec = json.loads(open(outp).read())
except Exception:
    sys.exit(0)
if rec.get("status") == "error":
    sys.exit(0)
rec["socket"] = sock
with open(inv, "a") as f:
    f.write(json.dumps(rec) + "\n")
PY
done < <(list_sockets | sort -u)

CATALOG="$REQDIR/catalog.json"
python3 "$CATALOG_PY" --inventory "$INVENTORY" --out "$CATALOG"

print_catalog() {
  python3 - "$CATALOG" <<'PY'
import json, sys
data = json.loads(open(sys.argv[1]).read())
for e in data.get("entries") or []:
    live = "live" if e.get("live") else "disk"
    pid = e.get("pid")
    pid_s = f"pid={pid}" if pid is not None else "pid=-"
    print(f"{e.get('harness')}\t{live}\t{e.get('id')}\t{pid_s}\t{e.get('path')}")
PY
}

if [[ "$OP" == catalog ]]; then
  cat "$CATALOG"
  exit 0
fi

if [[ "$OP" == list && -z "$SESSION" ]]; then
  print_catalog
  exit 0
fi

if [[ "$OP" == tty ]]; then
  exec "$SCRIPT_DIR/tty-eval" --plain --settle-ms "${ATOP_VI_SETTLE_MS:-3500}" -- "$SCRIPT_DIR/vi" open
fi

if [[ "$OP" == open ]]; then
  if [[ ! -t 0 || ! -t 1 ]]; then
    print_catalog
    printf 'atop-vi: open needs a TTY; catalog printed. Run `atop vi` from a real terminal, or `atop vi tty`.\n' >&2
    exit 0
  fi
  STABLE="${TMPDIR_REAL%/}/atop-vi.${USER}.catalog.json"
  cp "$CATALOG" "$STABLE"
  chmod 600 "$STABLE"
  COORD="${ATOP_VI_COORD:-${TMPDIR_REAL%/}/atop-vi.${USER}.md}"
  if [[ ! -f "$COORD" ]]; then
    cat > "$COORD" <<'EOF'
# atop-vi

Telescope: prompt buffers for herm / pi / claude / codex / cursor / others.
<CR> edit   <leader>fv reopen picker   :q leaves this coordinator buffer

Coordinate via `atop vi atop-vi get|set --file`. Ghostty is the outer host only.
EOF
    chmod 600 "$COORD"
  fi
  LISTEN_DIR="${TMPDIR_REAL%/}/nvim.${USER}/atop-vi"
  mkdir -p "$LISTEN_DIR"
  chmod 700 "$LISTEN_DIR"
  LISTEN="$LISTEN_DIR/nvim.$$.0"
  export ATOP_VI_CATALOG="$STABLE"
  export ATOP_VI_COORD="$COORD"
  export ATOP_VI="$SCRIPT_DIR/vi"
  exec "$NVIM_BIN" --listen "$LISTEN" \
    -c "lua require('kh.telescope-atop-vi').open()"
fi

# Resolve session → socket + path
RESOLVED="$(python3 - "$INVENTORY" "$SESSION" <<'PY'
import json, os, sys
inv, sid = sys.argv[1], sys.argv[2]
sid = sid.rstrip("/")
want = sid
if want.startswith("herm-") and want.endswith(".md"):
    pass
elif want.isdigit():
    pass
matches = []
for line in open(inv):
    rec = json.loads(line)
    sock = rec.get("socket", "")
    pid = rec.get("pid")
    for b in rec.get("buffers") or []:
        path = b.get("path") or ""
        name = os.path.basename(path)
        stem = name[:-3] if name.endswith(".md") else name
        keys = {name, stem, path, str(pid), str(b.get("buffer"))}
        if want in keys or want == stem.removeprefix("herm-") or path.endswith("/" + want) or want in path:
            matches.append((sock, path, b.get("buffer"), pid))
if not matches:
    sys.exit(2)
# prefer herm-*.md
matches.sort(key=lambda m: (0 if os.path.basename(m[1]).startswith("herm-") else 1, m[1]))
sock, path, buf, pid = matches[0]
print(f"{sock}\t{path}\t{buf}\t{pid}")
PY
)" || die "no open prompt buffer matching '$SESSION'"

IFS=$'\t' read -r SOCK PATH_BUF BUF PID <<<"$RESOLVED"
[[ -n "$SOCK" && -n "$PATH_BUF" ]] || die "failed to resolve $SESSION"

case "$OP" in
  list)
    printf '%s\tpid=%s\tbuf=%s\t%s\n' "$(basename "$PATH_BUF")" "$PID" "$BUF" "$PATH_BUF"
    ;;
  get|snapshot)
    req="$REQDIR/snap-req.json"
    out="$REQDIR/snap-out.json"
    python3 - "$req" "$out" "$PATH_BUF" "$BUF" <<'PY'
import json, sys
req, out, path, buf = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
json.dump({"op": "snapshot", "path": path, "buffer": buf, "output_path": out}, open(req, "w"))
open(req, "a").write("\n")
PY
    rpc "$SOCK" "$req" >/dev/null
    if [[ "$OP" == get ]]; then
      python3 - "$out" <<'PY'
import json, sys
rec = json.loads(open(sys.argv[1]).read())
if rec.get("status") == "error":
    raise SystemExit(rec.get("error") or "snapshot failed")
lines = rec.get("lines") or []
sys.stdout.write("\n".join(lines))
if lines:
    sys.stdout.write("\n")
PY
    else
      python3 - "$out" <<'PY'
import json, sys
rec = json.loads(open(sys.argv[1]).read())
print(json.dumps(rec, indent=2))
PY
    fi
    ;;
  set)
    [[ -f "$FILE" ]] || die "missing file $FILE"
    if [[ "$WAIT" == 1 ]]; then
      do_set_rpc "$REQDIR" "$SOCK" "$PATH_BUF" "$BUF" "$FILE" "$PID"
      exit 0
    fi
    JOB_ROOT="$(job_root)"
    mkdir -p "$JOB_ROOT"
    chmod 700 "$JOB_ROOT"
    JOB_ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex[:12])')"
    JOB_DIR="$JOB_ROOT/$JOB_ID"
    mkdir -p "$JOB_DIR"
    chmod 700 "$JOB_DIR"
    write_job_json "$JOB_DIR/job.json" "$JOB_ID" "running" "0" "$SESSION" "$PATH_BUF" "$FILE" "$SOCK"
    (
      trap - EXIT
      export ATOP_VI_JOB_DIR="$JOB_DIR"
      export ATOP_VI_SOCK="$SOCK"
      export ATOP_VI_PATH="$PATH_BUF"
      export ATOP_VI_BUF="$BUF"
      export ATOP_VI_FILE="$FILE"
      export ATOP_VI_PID="$PID"
      exec "$SCRIPT_DIR/vi" --internal-job-set
    ) >/dev/null 2>"$JOB_DIR/stderr" &
    echo $! >"$JOB_DIR/pid"
    write_job_json "$JOB_DIR/job.json" "$JOB_ID" "running" "$(cat "$JOB_DIR/pid")" "$SESSION" "$PATH_BUF" "$FILE" "$SOCK"
    python3 - "$JOB_DIR/job.json" <<'PY'
import json, sys
rec = json.loads(open(sys.argv[1]).read())
rec["poll"] = f"atop vi job {rec.get('id')}"
print(json.dumps(rec, indent=2))
PY
    ;;
esac
