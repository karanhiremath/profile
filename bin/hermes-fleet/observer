#!/usr/bin/env python3
"""Local redacted Prometheus/snapshot projection for Hermes fleet state."""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import json
import os
import subprocess
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

DEFAULT_AUDIT = Path(
    os.environ.get(
        "HERMES_FLEET_MANAGER_AUDIT",
        str(Path.home() / ".local/share/hermes-agents/chief-of-staff-work/profiles/chief-of-staff-work/host-control/audit/events.jsonl"),
    )
)


def esc(value: object) -> str:
    return str(value if value is not None else "").replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def labels(values: dict[str, object]) -> str:
    return "{" + ",".join(f'{key}="{esc(value)}"' for key, value in sorted(values.items())) + "}"


def audit(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    values = []
    with path.open(encoding="utf-8", errors="replace") as stream:
        for line in stream:
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict) and value.get("schema_version") == "sandbox.manager.v1":
                values.append(value)
    return values


def snapshot(command: str = "cosw-hostctl") -> dict[str, Any]:
    proc = subprocess.run(
        [command, "fleet-status"],
        text=True,
        capture_output=True,
        timeout=10,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "fleet manager snapshot failed")
    value = json.loads(proc.stdout)
    if not isinstance(value, dict) or value.get("ok") is not True or not isinstance(value.get("result"), dict):
        raise RuntimeError("fleet manager returned an invalid snapshot")
    return value["result"]


def metrics(events: list[dict[str, Any]], fleet: dict[str, Any], timestamp: float | None = None) -> str:
    now = timestamp if timestamp is not None else time.time()
    requests: collections.Counter[tuple[str, str, str]] = collections.Counter()
    errors: collections.Counter[tuple[str, str]] = collections.Counter()
    durations: collections.defaultdict[str, list[float]] = collections.defaultdict(list)
    for event in events:
        action = str(event.get("action") or "unknown")
        project = str(event.get("project") or "none")
        ok = "true" if event.get("ok") else "false"
        requests[action, project, ok] += 1
        durations[action].append(float(event.get("duration_ms") or 0) / 1000)
        if not event.get("ok"):
            errors[action, str(event.get("error_kind") or "unknown")] += 1
    lines = [
        "# HELP sandbox_manager_requests_total Classified sandbox manager requests.",
        "# TYPE sandbox_manager_requests_total counter",
    ]
    for (action, project, ok), count in sorted(requests.items()):
        lines.append(f"sandbox_manager_requests_total{labels({'action': action, 'ok': ok, 'project': project})} {count}")
    lines.extend([
        "# HELP sandbox_manager_errors_total Classified sandbox manager errors.",
        "# TYPE sandbox_manager_errors_total counter",
    ])
    for (action, kind), count in sorted(errors.items()):
        lines.append(f"sandbox_manager_errors_total{labels({'action': action, 'error_kind': kind})} {count}")
    lines.extend([
        "# HELP sandbox_manager_request_duration_seconds_sum Request duration by action.",
        "# TYPE sandbox_manager_request_duration_seconds_sum counter",
    ])
    for action, values in sorted(durations.items()):
        lines.append(f"sandbox_manager_request_duration_seconds_sum{labels({'action': action})} {sum(values):.6f}")
        lines.append(f"sandbox_manager_request_duration_seconds_count{labels({'action': action})} {len(values)}")
    lines.extend([
        "# HELP agent_sessions_active Registered PM and PL session liveness.",
        "# TYPE agent_sessions_active gauge",
    ])
    for project in fleet.get("projects") or []:
        if not isinstance(project, dict):
            continue
        for role in ("pm", "pl"):
            session = project.get(role) or {}
            lines.append(f"agent_sessions_active{labels({'project': project.get('name', ''), 'role': role, 'status': 'running' if session.get('running') else 'stopped'})} 1")
    observed = events[-1].get("observed_at") if events else None
    lag = 0.0
    if isinstance(observed, str):
        try:
            lag = max(0.0, now - dt.datetime.fromisoformat(observed.replace("Z", "+00:00")).timestamp())
        except ValueError:
            lag = 0.0
    lines.extend([
        "# HELP agent_source_lag_seconds Seconds since the latest manager audit event.",
        "# TYPE agent_source_lag_seconds gauge",
        f"agent_source_lag_seconds{labels({'source_name': 'hermes-sandbox-manager'})} {lag:.3f}",
    ])
    return "\n".join(lines) + "\n"


class Handler(BaseHTTPRequestHandler):
    audit_path = DEFAULT_AUDIT
    manager = "cosw-hostctl"

    def log_message(self, _format: str, *_args: object) -> None:
        return

    def send(self, code: int, body: str, content_type: str) -> None:
        raw = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self) -> None:
        if self.path == "/healthz":
            self.send(200, "ok\n", "text/plain; charset=utf-8")
            return
        try:
            fleet = snapshot(self.manager)
        except Exception as exc:
            self.send(503, json.dumps({"ok": False, "error": type(exc).__name__}) + "\n", "application/json")
            return
        if self.path == "/snapshot":
            self.send(200, json.dumps(fleet, separators=(",", ":")) + "\n", "application/json")
            return
        if self.path == "/metrics":
            self.send(200, metrics(audit(self.audit_path), fleet), "text/plain; version=0.0.4; charset=utf-8")
            return
        self.send(404, "not found\n", "text/plain; charset=utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=9470)
    parser.add_argument("--audit", type=Path, default=DEFAULT_AUDIT)
    parser.add_argument("--manager-client", default="cosw-hostctl")
    args = parser.parse_args()
    Handler.audit_path = args.audit.expanduser().resolve()
    Handler.manager = args.manager_client
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
