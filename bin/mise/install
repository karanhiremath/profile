#!/bin/bash

set -euo pipefail

shopt -s failglob

usage() {
    cat <<'EOF'
Usage: bin/mise/install [--help]

Install mise (the version/runtime manager), symlink the repo mise config into
~/.config/mise/config.toml, and run `mise install` to provision the declared
tools (node, pnpm, neovim).

macOS: installs via Homebrew (brew install mise).
Linux: installs via the official script at https://mise.run (lands in
       ~/.local/bin/mise).

Idempotent: re-running upgrades/repairs the install and re-syncs the config.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

# Set PROFILE_DIR and APP_BIN if not already set
if [ -z "${PROFILE_DIR:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export PROFILE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi

if [ -z "${APP_BIN:-}" ]; then
    export APP_BIN="${PROFILE_DIR}/bin"
fi

. "${APP_BIN}/sh/shell_fns" --source-only

app_name="mise"
MACHINE="$(uname -s)"

install_messages "start" "$app_name"

# --- Install mise if absent ---
if command -v mise >/dev/null 2>&1; then
    echo "✓ mise already installed: $(mise --version)"
else
    case "${MACHINE}" in
        Darwin|Mac)
            echo "Installing mise via Homebrew..."
            brew install mise
            ;;
        Linux|*)
            echo "Installing mise via https://mise.run ..."
            curl -fsSL https://mise.run | sh
            ;;
    esac
fi

# The Linux installer lands in ~/.local/bin, which may not be on PATH yet for
# this process. Make mise resolvable before we use it below.
if ! command -v mise >/dev/null 2>&1; then
    if [ -x "${HOME}/.local/bin/mise" ]; then
        export PATH="${HOME}/.local/bin:${PATH}"
    else
        echo "ERROR: mise not found on PATH after install." >&2
        exit 1
    fi
fi

# --- Symlink the repo mise config into place ---
mkdir -p "${HOME}/.config/mise"
ln -fns "${PROFILE_DIR}"/config/mise/config.toml "${HOME}"/.config/mise/config.toml
echo "✓ Linked mise config → ~/.config/mise/config.toml"

# --- Provision the declared tools, one at a time ---
# `mise install` aborts the whole run on the first tool it cannot fetch, so one
# upstream outage (or a proxy blocking one release asset) leaves the machine with
# nothing provisioned. Install each tool separately, keep going, and report a
# summary — a missing editor should not block node/pnpm/uv/python.
echo "Installing tools declared in mise config..."
mise_config="${PROFILE_DIR}/config/mise/config.toml"
# The config is the authoritative list of what SHOULD be installed. `mise ls`
# omits any tool whose version it cannot resolve, which would silently skip the
# one tool that is broken instead of reporting it.
tools="$(python3 "${PROFILE_DIR}/bin/mise/config-tools" "$mise_config" 2>/dev/null || true)"
if [ -z "$tools" ]; then
    # Fresh box: mise is what provides Python, so tomllib may not exist yet.
    tools="$(sed -n '/^\[tools\]/,/^\[[^t]/p' "$mise_config" \
        | sed -n 's/^\([a-zA-Z0-9_-]*\) *=.*/\1/p')"
fi

failed=""
installed=""
for tool in $tools; do
    printf '  %-10s ' "$tool"
    if mise install "$tool" >/dev/null 2>&1; then
        echo "✓"
        installed="${installed} ${tool}"
    else
        echo "✗ (see: mise install ${tool})"
        failed="${failed} ${tool}"
    fi
done

echo ""
echo "provisioned:${installed:- none}"
if [ -n "$failed" ]; then
    echo "FAILED:${failed}"
    echo ""
    echo "A tool can fail for reasons outside this repo — an upstream release"
    echo "pulled, a plugin's API changed, or egress to the release host blocked."
    if [ "${MISE_ALLOW_PARTIAL:-0}" = "1" ] || [ "${1:-}" = "--allow-partial" ]; then
        echo "Continuing anyway (--allow-partial / MISE_ALLOW_PARTIAL=1)."
    else
        echo "Re-run with --allow-partial to accept a partial provision."
        exit 1
    fi
fi

install_messages "end" "$app_name"

echo ""
echo "mise installed. Tools provisioned from ~/.config/mise/config.toml."
echo "Ensure your shell activates mise: eval \"\$(mise activate zsh|bash)\""
echo "(already wired in zsh_profile.sh / bash_profile.sh)."
echo ""
