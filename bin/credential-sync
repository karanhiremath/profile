#!/usr/bin/env bash
# credential-sync — generic, harness-agnostic credential grant plane entrypoint.
#
# One command every agent launcher (cosw/cos/herm/agents/dreamw/pm) calls before
# seat spawn. Launchers must contain zero provider- or harness-specific credential
# logic; this dispatcher owns the routing:
#
#   1. host-domain cred backend     -> <backend> materialize (durable path)
#   2. legacy dispatch table        -> provider-specific sync implementations
#                                      (codex grants -> hermes/codex_grant_sync.py)
#   3. provider not registered      -> structured no-op; never guess
#
# Contract: stdout is a single-line JSON payload only; diagnostics go to stderr.
# Credential values never appear on stdout or stderr. Mutating path is the
# canonical store heal only; dry-run semantics belong to the backend.
#
# Env:
#   CREDENTIAL_SYNC_LEGACY_DIR  override dir holding legacy provider impls
#                               (default: <script_dir>/hermes). For tests.
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/credential-sync -> profile repo) portably.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  _dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$_dir/$SOURCE" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LEGACY_DIR="${CREDENTIAL_SYNC_LEGACY_DIR:-$SCRIPT_DIR/hermes}"

usage() {
  cat <<'EOF'
Usage:
  credential-sync --provider <provider> [--seat <seat>] [--json]
  credential-sync --help

Options:
  --provider <p>   provider of the active seat (openai-codex, anthropic, ...)
  --seat <s>       seat name (informational; carried in payload)
  --json           payload flag (stdout is always JSON)

Exit codes:
  0  synced, adopted, or structured no-op
  1  sync attempted and failed (launchers log and continue)
  2  usage error
EOF
}

die() { printf 'credential-sync: %s\n' "$1" >&2; exit 2; }

PROVIDER=""
SEAT=""
JSON=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) [ "$#" -ge 2 ] || die "--provider needs a value"; PROVIDER="$2"; shift 2 ;;
    --provider=*) PROVIDER="${1#*=}"; shift ;;
    --seat) [ "$#" -ge 2 ] || die "--seat needs a value"; SEAT="$2"; shift 2 ;;
    --seat=*) SEAT="${1#*=}"; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

emit() {
  # emit <status> <path> <reason>  -> single-line JSON on stdout
  printf '{"schema":"credential-sync.v1","status":"%s","path":"%s","provider":"%s","seat":"%s","reason":"%s"}\n' \
    "$1" "$2" "$PROVIDER" "$SEAT" "$3"
}

# Registry: provider -> backend materialize targets (csv).
# New seats/providers = registry entries, never launcher forks.
registry_targets() {
  case "$1" in
    openai-codex|codex) printf 'codex-cli,hermes,pi' ;;
    *) return 1 ;;
  esac
}

TARGETS=""
if [ -n "$PROVIDER" ]; then
  TARGETS="$(registry_targets "$PROVIDER" || true)"
fi

# Path 1 — host-domain backend: a cred-backend.v1 executable under
# ~/.config/cred/backends.d whose declared domain matches this host claims the
# provider. Profile never names a backend; work/other auth planes register
# themselves there (see docs/cred.md). cred exits 3 when no backend claims it.
if [ -n "$TARGETS" ]; then
  rc=0
  python3 "$SCRIPT_DIR/cred/cred" materialize --provider "$PROVIDER" --targets "$TARGETS" --apply >/dev/null || rc=$?
  case "$rc" in
    0) emit ok backend ""; exit 0 ;;
    3) ;;
    *) emit fail backend "materialize-failed"
       printf 'credential-sync: backend materialize failed\n' >&2
       exit 1 ;;
  esac
fi

# Path 2 — legacy dispatch table.
legacy_impl() {
  case "$1" in
    openai-codex|codex) printf '%s/codex_grant_sync.py' "$LEGACY_DIR" ;;
    *) return 1 ;;
  esac
}

LEGACY=""
if [ -n "$TARGETS" ]; then
  LEGACY="$(legacy_impl "$PROVIDER" || true)"
  if [ -n "$LEGACY" ] && [ -f "$LEGACY" ]; then
    if out="$(python3 "$LEGACY" adopt 2>/dev/null)"; then
      # out is lengths/booleans only by design; never re-emit raw.
      emit ok legacy ""
    else
      emit fail legacy "adopt-failed"
      printf 'credential-sync: legacy adopt failed\n' >&2
      exit 1
    fi
  else
    emit fail none "legacy-impl-missing:$LEGACY"
    printf 'credential-sync: legacy impl missing: %s\n' "$LEGACY" >&2
    exit 1
  fi
  exit 0
fi

# Path 3 — structured no-op: provider unregistered or unspecified. Never guess.
if [ -z "$PROVIDER" ]; then
  emit noop none "missing-provider"
else
  emit noop none "provider-not-registered"
fi
exit 0