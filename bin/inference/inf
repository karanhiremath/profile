def read_active() -> dict[str, str]:
    if ACTIVE_FILE.exists():
        try:
            return json.loads(ACTIVE_FILE.read_text()).get("harnesses", {})
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def write_active(harness: str, bid: str | None) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    doc = {"harnesses": read_active()}
    if bid is None:
        doc["harnesses"].pop(harness, None)
    else:
        doc["harnesses"][harness] = bid
    doc["updated"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    ACTIVE_FILE.write_text(json.dumps(doc, indent=2) + "\n")


def load_json(path: Path) -> dict:
    if path.exists():
        try:
            return json.loads(path.read_text())
        except json.JSONDecodeError:
            info(f"{WARN} {path} is not valid JSON; starting from empty")
    return {}


def save_json(path: Path, doc: dict, dry_run: bool) -> None:
    text = json.dumps(doc, indent=2) + "\n"
    if dry_run:
        print(f"--- would write {path} ---\n{text}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        backup = path.with_suffix(path.suffix + ".inf-bak")
        backup.write_text(path.read_text())
    path.write_text(text)
    info(f"{OK} wrote {path}")


def bind_pi(b: dict[str, Any], dry_run: bool) -> int:
    binding = ((b.get("bindings") or {}).get("pi") or {})
    if binding.get("unsupported"):
        die(f"pi cannot bind {b['id']}: {binding.get('reason', 'unsupported')}")
    pi_dir = Path(os.environ.get("PI_AGENT_DIR") or (Path.home() / ".pi" / "agent"))
    provider = binding.get("provider") or b["id"]
    model_id = binding.get("model_id") or (b.get("model") or {}).get("served_name")

    if b.get("api") == "openai-codex":
        # Native pi provider: no models.json entry needed, just the defaults.
        settings = load_json(pi_dir / "settings.json")
        settings["defaultProvider"] = provider
        settings["defaultModel"] = model_id
        enabled = [e for e in settings.get("enabledModels", []) if not e.startswith(f"{provider}/")]
        settings["enabledModels"] = sorted(set(enabled + [f"{provider}/{model_id}"]))
        save_json(pi_dir / "settings.json", settings, dry_run)
        return 0

    if not b.get("base_url"):
        die(f"{b['id']} has no OpenAI-compatible endpoint; pi cannot use it as a provider")
    caps = b.get("capabilities") or {}
    models_doc = load_json(pi_dir / "models.json")
    providers = models_doc.setdefault("providers", {})
    providers[provider] = {
        "baseUrl": b["base_url"],
        "api": "openai-completions",
        # pi reads the key from this env var at runtime, so no secret is written.
        "apiKey": f"${{{(b.get('auth') or {}).get('api_key_env', 'INF_API_KEY')}:-{(b.get('auth') or {}).get('api_key_default', 'none')}}}",
        "compat": {
            "supportsDeveloperRole": bool(caps.get("developer_role")),
            "supportsReasoningEffort": bool(caps.get("reasoning_effort")),
        },
        "models": [{"id": model_id, "name": f"{model_id} ({b['id']})"}],
    }
    models_doc["_managed_by"] = "profile/bin/inference/inf — edits may be overwritten by `inf bind pi`"
    save_json(pi_dir / "models.json", models_doc, dry_run)

    settings = load_json(pi_dir / "settings.json")
    settings["defaultProvider"] = provider
    settings["defaultModel"] = model_id
    enabled = [e for e in settings.get("enabledModels", []) if not e.startswith(f"{provider}/")]
    settings["enabledModels"] = sorted(set(enabled + [f"{provider}/{model_id}"]))
    save_json(pi_dir / "settings.json", settings, dry_run)
    return 0


def bind_hermes(b: dict[str, Any], dry_run: bool, profile: str | None) -> int:
    """Hermes profiles read `llm.backend` and resolve it here, so the binding is
    just the active-backend pointer plus an env file the launcher can source."""
    binding = ((b.get("bindings") or {}).get("hermes") or {})
    if binding.get("unsupported"):
        die(f"hermes cannot bind {b['id']}: {binding.get('reason', 'unsupported')}")
    provider = binding.get("provider") or ("openai-compat" if b.get("api") == "openai-chat" else b.get("api"))
    model = binding.get("model") or (b.get("model") or {}).get("served_name")
    env_path = STATE_DIR / "hermes-backend.env"
    lines = [
        "# Generated by `inf bind hermes`. Sourced by bin/hermes/agents. Do not edit.",
        f"HERMES_AGENT_MODEL_PROVIDER={provider}",
        f"HERMES_AGENT_MODEL_DEFAULT={model}",
    ]
    if b.get("base_url"):
        lines.append(f"HERMES_AGENT_MODEL_BASE_URL={b['base_url']}")
    key_env = (b.get("auth") or {}).get("api_key_env")
    if key_env:
        lines.append(f"HERMES_AGENT_MODEL_API_KEY_ENV={key_env}")
    if profile:
        lines.append(f"HERMES_AGENT_PROFILE_SCOPE={profile}")
    text = "\n".join(lines) + "\n"
    if dry_run:
        print(f"--- would write {env_path} ---\n{text}")
    else:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        env_path.write_text(text)
        info(f"{OK} wrote {env_path}")
    info("herm/hermes picks this up on next launch (cos / cosw / pm / pl).")
    return 0


def bind_cursor(b: dict[str, Any], dry_run: bool) -> int:
    binding = ((b.get("bindings") or {}).get("cursor") or {})
    if b.get("api") != "cursor-cli" and not binding.get("model"):
        die(f"cursor-agent only drives its own hosted models; {b['id']} (api={b.get('api')}) "
            f"is not one. Bind a cursor-* backend, or use {b['id']} with pi/hermes instead.")
    model = binding.get("model") or (b.get("model") or {}).get("served_name")
    cfg_path = Path.home() / ".cursor" / "cli-config.json"
    cfg = load_json(cfg_path)
    cfg["model"] = model
    # Keep the fleet security posture from AGENTS.md: never --force / --yolo.
    cfg.setdefault("approvalMode", "allowlist")
    cfg.setdefault("sandbox", {}).setdefault("mode", "disabled")
    save_json(cfg_path, cfg, dry_run)
    return 0


def bind_env_harness(b: dict[str, Any], harness: str, dry_run: bool) -> int:
    """claude / codex: emit an env file the launcher sources."""
    path = STATE_DIR / f"{harness}-backend.env"
    model = ((b.get("bindings") or {}).get(harness) or {}).get("model") or (b.get("model") or {}).get("served_name")
    lines = [f"# Generated by `inf bind {harness}`. Source before launching {harness}."]
    if harness == "claude":
        if b.get("api") == "anthropic":
            lines.append(f"ANTHROPIC_MODEL={model}")
            if b.get("base_url"):
                lines.append(f"ANTHROPIC_BASE_URL={b['base_url']}")
        elif b.get("base_url"):
            # Claude Code can front an OpenAI-compatible endpoint via a proxy only.
            lines.append(f"# {b['id']} speaks {b.get('api')}, not the Anthropic API.")
            lines.append(f"# Route it through an anthropic-compat proxy, then set ANTHROPIC_BASE_URL.")
            lines.append(f"INF_OPENAI_BASE_URL={b['base_url']}")
            lines.append(f"INF_MODEL={model}")
        else:
            die(f"claude cannot bind {b['id']} (api={b.get('api')})")
    else:  # codex
        lines.append(f"CODEX_MODEL={model}")
        if b.get("base_url"):
            lines.append(f"OPENAI_BASE_URL={b['base_url']}")
    text = "\n".join(lines) + "\n"
    if dry_run:
        print(f"--- would write {path} ---\n{text}")
    else:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        info(f"{OK} wrote {path}")
    return 0


def cmd_bind(args) -> int:
    harness = args.harness
    if harness not in HARNESSES:
        die(f"unknown harness '{harness}' (known: {', '.join(HARNESSES)})")
    b = resolve(args.backend)
    if b.get("template"):
        die(f"{b['id']} is a template — copy it to a real backend id first")
    if args.probe:
        rc = cmd_probe(argparse.Namespace(backend=args.backend, timeout=20, json=False))
        if rc != 0:
            die(f"refusing to bind {harness} to an unhealthy backend (use --no-probe to force)")
    if harness == "pi":
        rc = bind_pi(b, args.dry_run)
    elif harness == "hermes":
        rc = bind_hermes(b, args.dry_run, args.profile)
    elif harness == "cursor":
        rc = bind_cursor(b, args.dry_run)
    else:
        rc = bind_env_harness(b, harness, args.dry_run)
    if rc == 0 and not args.dry_run:
        write_active(harness, b["id"])
        print(f"{OK} {harness} → {c(b['id'], '1;36')} "
              f"({b.get('runtime')}, {b.get('cost_class')})")
    return rc


def cmd_unbind(args) -> int:
    _, defaults, _ = load_registry()
    fallback = defaults.get("backend")
    if not fallback:
        die("[defaults] backend is not set; nothing to fall back to")
    info(f"restoring {args.harness} to the registry default ({fallback})")
    return cmd_bind(argparse.Namespace(harness=args.harness, backend=fallback,
                                       dry_run=args.dry_run, probe=False, profile=None))


def cmd_active(args) -> int:
    active = read_active()
    if not active:
        _, defaults, _ = load_registry()
        print(f"nothing bound; harnesses fall back to the registry default: {defaults.get('backend')}")
        return 0
    for harness in HARNESSES:
        bid = active.get(harness)
        print(f"{harness:<8} {bid or '(default)'}")
    return 0


# ──────────────────────────────────  main  ────────────────────────────────────

def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="inf", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="list backends")
    sp.add_argument("--kind", choices=sorted(KINDS))
    sp.add_argument("--local", dest="local_only", action="store_true")
    sp.add_argument("--all", action="store_true", help="include templates")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("show", help="show a resolved backend")
    sp.add_argument("backend")
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("validate", help="schema-check the registry (CI gate)")
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("doctor", help="check machine prerequisites")
    sp.add_argument("backend", nargs="?")
    sp.add_argument("--strict", action="store_true", help="exit non-zero on any missing prerequisite")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("env", help="print shell exports for a backend")
    sp.add_argument("backend")
    sp.set_defaults(func=cmd_env)

    sp = sub.add_parser("up", help="start a local backend")
    sp.add_argument("backend")
    sp.add_argument("--build", action="store_true", help="rebuild the sandbox image first")
    sp.add_argument("--wait", type=int, default=180, help="seconds to wait for health (0 = don't)")
    sp.add_argument("--dry-run", action="store_true", help="print the engine command only")
    sp.set_defaults(func=cmd_up)

    sp = sub.add_parser("down", help="stop a local backend")
    sp.add_argument("backend")
    sp.set_defaults(func=cmd_down)

    sp = sub.add_parser("status", help="what is running")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("probe", help="OpenAI-compat conformance check")
    sp.add_argument("backend")
    sp.add_argument("--timeout", default=20)
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_probe)

    sp = sub.add_parser("bench", help="throughput, and speculative speedup vs baseline")
    sp.add_argument("backend")
    sp.add_argument("--baseline", help="backend id to compare against")
    sp.add_argument("--no-baseline", action="store_true")
    sp.add_argument("--runs", type=int, default=3)
    sp.add_argument("--max-tokens", type=int)
    sp.add_argument("--prompt")
    sp.add_argument("--out", help="write JSON results here")
    sp.set_defaults(func=cmd_bench)

    sp = sub.add_parser("bind", help="render harness-native config")
    sp.add_argument("harness", choices=HARNESSES)
    sp.add_argument("backend")
    sp.add_argument("--profile", help="hermes profile scope")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--probe", action="store_true", help="refuse to bind an unhealthy backend")
    sp.set_defaults(func=cmd_bind)

    sp = sub.add_parser("unbind", help="restore a harness to the registry default")
    sp.add_argument("harness", choices=HARNESSES)
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(func=cmd_unbind)

    sp = sub.add_parser("active", help="show harness bindings")
    sp.set_defaults(func=cmd_active)

    args = p.parse_args(argv)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
