#!/usr/bin/env bash
# Build the browser-eval Podman image.
# Usage: build [--image NAME] [--runtime podman|docker]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

usage() {
  sed -n '2,4p' "$0" | sed 's/^# //'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --image) IMAGE="${2:?missing image}"; shift 2 ;;
    --runtime) RUNTIME="${2:?missing runtime}"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) echo "ERROR: unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

command -v "$RUNTIME" >/dev/null 2>&1 || die "runtime not found: $RUNTIME"

cd "$LAB_DIR"
build_args=()
if [ "$RUNTIME" = "podman" ]; then
  build_args+=(--format=docker)
fi
"$RUNTIME" build \
  "${build_args[@]}" \
  --pull=newer \
  --label org.opencontainers.image.title="browser-eval" \
  --label org.opencontainers.image.description="Sandbox for OSS agentic browsers and backup drivers" \
  -t "$IMAGE" \
  -f Containerfile \
  .
