#!/usr/bin/env bash
# Run a command inside the browser-eval container.
# Usage: run [--image NAME] [--runtime podman|docker] [--allow-network] [--no-mount] -- <command...>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

usage() {
  sed -n '2,4p' "$0" | sed 's/^# //'
}

NETWORK="none"
MOUNT=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --image) IMAGE="${2:?missing image}"; shift 2 ;;
    --runtime) RUNTIME="${2:?missing runtime}"; shift 2 ;;
    --allow-network) NETWORK="slirp4netns"; shift ;;
    --no-mount) MOUNT=0; shift ;;
    --) shift; break ;;
    -h|--help|help) usage; exit 0 ;;
    *) break ;;
  esac
done

if [ "$#" -eq 0 ]; then
  echo "ERROR: missing command" >&2
  usage
  exit 2
fi
command -v "$RUNTIME" >/dev/null 2>&1 || die "runtime not found: $RUNTIME"
ensure_dirs

run_args=(
  --rm
  --network "$NETWORK"
  --security-opt no-new-privileges
  --cap-drop ALL
  --pids-limit 512
  --memory "${BROWSER_EVAL_MEMORY:-2g}"
  --cpus "${BROWSER_EVAL_CPUS:-2}"
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=512m
)
# New host dirs are often invisible to an already-running podman machine
# (statfs ENOENT). Smoke captures stdout on the host; skip mounts there.
if [[ "$MOUNT" -eq 1 ]]; then
  run_args+=(--volume "$WORKSPACE_DIR:/workspace:rw,z")
  run_args+=(--volume "$ARTIFACTS_DIR:/artifacts:rw,z")
fi
"$RUNTIME" run "${run_args[@]}" "$IMAGE" "$@"
