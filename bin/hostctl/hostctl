        log "created Termix credential ${cred_id}"
    else
        termix_cli credentials update \
            --auth-type key \
            --username "${ssh_user}" \
            --key-file "$key" \
            "$cred_id" >/dev/null
        log "updated Termix credential ${cred_id}"
    fi
    host_id="$(termix_cli hosts list | python3 -c '
import json,sys
data=json.load(sys.stdin)
rows=data.get("hosts") or []
for row in rows:
    if row.get("name")=="khire-mac-mini-hostctl":
        print(row.get("id") or "")
        break
')"
    if [ -z "$host_id" ]; then
        host_id="$(termix_cli hosts create \
            --name khire-mac-mini-hostctl \
            --ip host.containers.internal \
            --port 22 \
            --username "${ssh_user}" \
            --auth-type key \
            --key-file "$key" \
            --tags termix-master,hostctl \
