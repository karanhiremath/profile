cmd="${1:-status}"
shift || true
case "$cmd" in
    -h|--help|help)
        usage
        ;;
    status)
        engine_status
        echo
        termix_cmd status
        echo
        omarchy_cmd status
        ;;
    up)
        ensure_machine
        termix_cmd up
        ;;
    down)
        termix_cmd down
        ;;
    termix)
        termix_cmd "${1:-status}" "${@:2}"
        ;;
    omarchy)
        omarchy_cmd "${1:-status}" "${@:2}"
        ;;
    attach|ix)
        exec "${APP_BIN}/tmux/interactive" "$@"
        ;;
    sandbox)
        exec "${SCRIPT_DIR}/sandbox" "${1:-attach}" "${@:2}"
        ;;
    machine)
        case "${1:-}" in
            mounts)
                python3 "${SCRIPT_DIR}/lib/podman_mounts.py" --apply
                ;;
            *) die "machine commands: mounts" ;;
        esac
        ;;
    hosts)
        print_hosts
        ;;
    role)
        print_role
        ;;
    master)
        case "${1:-status}" in
            status) master_status ;;
            provision) master_provision ;;
            push) master_push ;;
            phone) master_phone ;;
            login) master_login_push ;;
            keychain-seed) master_keychain_seed ;;
            *) die "master commands: provision|status|push|phone|login|keychain-seed" ;;
        esac
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
