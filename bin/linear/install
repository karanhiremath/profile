#!/bin/bash

set -euo pipefail

shopt -s failglob

if [ -z "${PROFILE_DIR:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export PROFILE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
else
    SCRIPT_DIR="${PROFILE_DIR}/bin/linear"
fi

if [ -z "${APP_BIN:-}" ]; then
    export APP_BIN="${PROFILE_DIR}/bin"
fi

. "${APP_BIN}/sh/shell_fns" --source-only

usage() {
    cat <<'EOF'
Usage: bin/linear/install [--help]

Write ~/.linear/coding-tools.json for Linear "Work on issue → Custom script",
link the pi /linear-issue prompt, and print the Code & reviews template.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

app_name="linear-open-issue"
OPEN_ISSUE="${SCRIPT_DIR}/open-issue"
TEMPLATE="${SCRIPT_DIR}/prompt-template.md"
PI_PROMPT="${SCRIPT_DIR}/pi-prompt.md"
CODING_TOOLS="${HOME}/.linear/coding-tools.json"

install_messages "start" "$app_name"

chmod +x "$OPEN_ISSUE"

mkdir -p "${HOME}/.linear" "${HOME}/.pi/agent/prompts"
ln -fns "$PI_PROMPT" "${HOME}/.pi/agent/prompts/linear-issue.md"

python3 - "$CODING_TOOLS" "$OPEN_ISSUE" <<'PY'
import json, os, sys
dest, path = sys.argv[1], sys.argv[2]
cfg = {
    "openIssue": {
        "path": os.path.abspath(path),
        "env": [
            "LINEAR_PROMPT",
            "LINEAR_ISSUE_IDENTIFIER",
            "LINEAR_ISSUE_BRANCH_NAME",
            "LINEAR_WORK_DIR",
            "LINEAR_PROJECT_NAME",
            "LINEAR_PULL_REQUEST_COMMENT_ID",
            "LINEAR_TOOL_COMMAND",
        ],
    }
}
os.makedirs(os.path.dirname(dest), exist_ok=True)
with open(dest, "w", encoding="utf-8") as fh:
    json.dump(cfg, fh, indent=2)
    fh.write("\n")
os.chmod(dest, 0o600)
print(dest)
PY

if [ "${LINEAR_OPEN_ISSUE_SKIP_PBCOPY:-0}" != "1" ] && command -v pbcopy >/dev/null 2>&1; then
    "$OPEN_ISSUE" --print-prompt-template | pbcopy
    echo "✓ Linear prompt template copied to clipboard" >&2
fi

install_messages "end" "$app_name"

cat <<EOF >&2

Linear desktop (once):
  1. Settings → Code & reviews → Configure coding tools → enable Custom script
  2. Paste the prompt template (clipboard / ${TEMPLATE})
  3. Work on issue → Custom script; pick a repo under ~/src

Files:
  ${CODING_TOOLS}
  ${HOME}/.pi/agent/prompts/linear-issue.md  (/linear-issue)
EOF
