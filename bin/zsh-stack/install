#!/bin/bash
# fzf + zsh-autosuggestions + zsh-syntax-highlighting + zsh-completions + fzf-tab
set -euo pipefail
shopt -s failglob

if [ -z "${PROFILE_DIR:-}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export PROFILE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi
if [ -z "${APP_BIN:-}" ]; then
    export APP_BIN="${PROFILE_DIR}/bin"
fi

. "${APP_BIN}/sh/shell_fns" --source-only
. "${APP_BIN}/sh/brew_helper.sh"

app_name="zsh-stack"
PLUGIN_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
MACHINE="$(uname -s)"

install_messages "start" "$app_name"
mkdir -p "$PLUGIN_HOME"

clone_plugin() {
    local name="$1"
    local url="$2"
    local dest="${PLUGIN_HOME}/${name}"
    if [ -d "${dest}/.git" ]; then
        git -C "$dest" pull --ff-only >/dev/null
        echo "✓ updated ${name}"
        return 0
    fi
    if [ -d "$dest" ]; then
        echo "✓ ${name} already present"
        return 0
    fi
    git clone --depth 1 "$url" "$dest"
    echo "✓ cloned ${name}"
}

if [[ "${MACHINE}" == Darwin || "${MACHINE}" == Mac ]]; then
    ensure_brew_in_path || {
        echo "ERROR: Homebrew not found. Please install Homebrew first."
        exit 1
    }
    for formula in fzf zsh-autosuggestions zsh-syntax-highlighting zsh-completions; do
        if brew list --formula "$formula" >/dev/null 2>&1; then
            echo "✓ brew ${formula}"
        else
            brew install "$formula"
        fi
    done
else
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y fzf zsh || true
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y fzf zsh || true
    fi
    clone_plugin zsh-autosuggestions https://github.com/zsh-users/zsh-autosuggestions
    clone_plugin zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting
    clone_plugin zsh-completions https://github.com/zsh-users/zsh-completions
fi

clone_plugin fzf-tab https://github.com/Aloxaf/fzf-tab

# Keep cmdk on PATH for Ghostty new_tab:cmdk-ghostty
mkdir -p "${HOME}/.local/bin"
ln -sfn "${PROFILE_DIR}/bin/cmdk/cmdk" "${HOME}/.local/bin/cmdk"
ln -sfn "${PROFILE_DIR}/bin/cmdk/cmdk-ghostty" "${HOME}/.local/bin/cmdk-ghostty"
chmod +x "${PROFILE_DIR}/bin/cmdk/cmdk" "${PROFILE_DIR}/bin/cmdk/cmdk-ghostty" "${PROFILE_DIR}/bin/cmdk/lib.py"

install_messages "end" "$app_name"
echo "zsh-stack ready. Reload with: source ~/.zshrc"
