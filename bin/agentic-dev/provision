#!/usr/bin/env bash
# Provision CosW + project registries for this host class.
# Usage: provision [--mode host|sandbox] [--project NAME] [--dry-run] [--help]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/agentic-dev/provision [--mode host|sandbox] [--project NAME] [--dry-run]

personal host:
  hermes private-sync
  bootstrap krop-tf / krop-infra / krop-ai
  write missing personal CosW + krop project YAML under ~/src/hermes
  configure-machine
  harness-sync apply
  write ~/.config/profile/agentic-host.env
  refuse KH / work-registry writes

work host:
  require ~/src/karan.hiremath
  write ~/.config/profile/agentic-host.env with work-gated paths
  harness-sync apply
  refuse krop bootstrap and personal CosW overwrite

sandbox:
  require --project
  personal: project must be krop-tf|krop-infra|krop-ai
  work: project must not be krop-*; must exist under the work registry
  write isolated state under AGENTIC_PREFIX
EOF
}

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
AGENTIC_DEV_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROFILE_DIR="${PROFILE_DIR:-$(cd "$AGENTIC_DEV_DIR/../.." && pwd)}"
APP_BIN="${APP_BIN:-$PROFILE_DIR/bin}"

MODE="${AGENTIC_MODE:-host}"
PROJECT="${AGENTIC_PROJECT:-}"
DRY_RUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    --mode) MODE="${2:?missing mode}"; shift 2 ;;
    --project) PROJECT="${2:?missing project}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    *)
      echo "provision: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# shellcheck source=host-env.sh
. "$AGENTIC_DEV_DIR/host-env.sh"
CLASS="$AGENTIC_HOST_CLASS"

log() { printf 'provision: %s\n' "$*" >&2; }
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'provision(dry-run):'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

write_file() {
  local dest="$1" content="$2"
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run write $dest"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  printf '%s' "$content" >"$dest"
}

KROP_PROJECTS=(krop-tf krop-infra krop-ai)
is_krop_project() {
  local p="$1"
  case "$p" in
    krop-tf|krop-infra|krop-ai|tf|infra|ai) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_krop() {
  case "$1" in
    tf) printf 'krop-tf\n' ;;
    infra) printf 'krop-infra\n' ;;
    ai) printf 'krop-ai\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

ENV_FILE="${AGENTIC_HOST_ENV:-$HOME/.config/profile/agentic-host.env}"

write_host_env_file() {
  local body
  body="$(cat <<EOF
# Generated by bin/agentic-dev/provision. Do not put secrets here.
# class=${CLASS} plane=${AGENTIC_COSW_PLANE} mode=${MODE}
export AGENTIC_HOST_CLASS=${CLASS}
export AGENTIC_COSW_PLANE=${AGENTIC_COSW_PLANE}
export HERMES_AGENT_PROFILE_PATH=$(printf '%q' "$HERMES_AGENT_PROFILE_PATH")
export HERMES_PROJECT_REGISTRY_PATH=$(printf '%q' "$HERMES_PROJECT_REGISTRY_PATH")
export HERMES_PROJECT_REGISTRY_DIRS=$(printf '%q' "$HERMES_PROJECT_REGISTRY_PATH")
EOF
)"
  write_file "$ENV_FILE" "$body"$'\n'
  log "host env -> $ENV_FILE"
}

krop_project_yaml() {
  local name="$1"
  cat <<EOF
name: ${name}
aliases: [${name#krop-}]
description: "Personal krop ${name} — home-mac CosW only. Never mix with the work checkout."
workdir: ~/src/${name}

pm:
  profile: chief-of-staff-work

tmux:
  pm_session: ${name}-pm
  pl_session: ${name}-pl
  workdir: ~/src/${name}

event_bus:
  ledger: ~/src/hermes/projects/${name}-events.jsonl
  publish_paths:
    - path: ~/src/hermes/projects/${name}-events.jsonl
  sources:
    - key: project-events
      path: ~/src/hermes/projects/${name}-events.jsonl
      writable: true
  event_types:
    - project_registered
    - pm_started
    - pm_attached
    - project_lead_started
    - project_lead_attached
    - handoff_created
    - pm_action_required
    - task_status
    - kanban_transition
    - blocker
    - decision

handoffs:
  latest_pm: ~/src/${name}/LATEST-pm-handoff.md
  latest_project_lead: ~/src/${name}/LATEST-project-lead-handoff.md

kanban:
  provider: personal
  policy: "Capture task status in the personal ledger. No work-checkout paths."
EOF
}

provision_personal_host() {
  local hermes_dir="$HOME/src/hermes"
  local dest proj dir yaml_path
  if [ -x "$APP_BIN/hermes/private-sync" ]; then
    run "$APP_BIN/hermes/private-sync"
  fi
  if [ -x "$APP_BIN/krop" ]; then
    run "$APP_BIN/krop" all bootstrap
  fi

  dest="$hermes_dir/profiles/chief-of-staff-work.yaml"
  if [ ! -f "$dest" ] && [ -f "$hermes_dir/profiles/chief-of-staff-work.yaml.example" ]; then
    run cp "$hermes_dir/profiles/chief-of-staff-work.yaml.example" "$dest"
  fi
  if [ ! -f "$dest" ] && [ -f "$PROFILE_DIR/config/hermes/chief-of-staff-work.personal.yaml" ]; then
    run cp "$PROFILE_DIR/config/hermes/chief-of-staff-work.personal.yaml" "$dest"
  fi

  mkdir -p "$hermes_dir/projects"
  for proj in "${KROP_PROJECTS[@]}"; do
    dir="$HOME/src/${proj}"
    yaml_path="$hermes_dir/projects/${proj}.yaml"
    if [ -f "$yaml_path" ]; then
      log "keep existing $yaml_path"
      continue
    fi
    write_file "$yaml_path" "$(krop_project_yaml "$proj")"$'\n'
    log "wrote $yaml_path"
  done

  if [ -x "$APP_BIN/hermes/configure-machine" ]; then
    run "$APP_BIN/hermes/configure-machine" --skip-install --skip-auth-import || true
  fi
  if [ -x "$APP_BIN/atop/harness-sync" ]; then
    run "$APP_BIN/atop/harness-sync" apply || true
  fi
  write_host_env_file
}

provision_work_host() {
  local kh="${AGENTIC_KH_DIR:-$HOME/src/karan.hiremath}"
  if [ ! -d "$kh" ]; then
    log "ERROR: work class requires $kh"
    exit 1
  fi
  if [ -x "$APP_BIN/krop" ] && [ "$DRY_RUN" -eq 0 ]; then
    log "work class: skipping krop bootstrap"
  fi
  if [ -x "$APP_BIN/atop/harness-sync" ]; then
    run "$APP_BIN/atop/harness-sync" apply || true
  fi
  write_host_env_file
  log "work CosW profiles expected under $kh/agentic/hermes/profiles"
  log "work projects expected under $kh/agentic/hermes/projects"
}

provision_sandbox() {
  local proj root envf
  proj="$(normalize_krop "$PROJECT")"
  if [ "$CLASS" = personal ]; then
    is_krop_project "$PROJECT" || {
      log "ERROR: personal sandbox project must be krop-tf|krop-infra|krop-ai (got $PROJECT)"
      exit 2
    }
  else
    if is_krop_project "$PROJECT"; then
      log "ERROR: work sandbox refuses krop-* projects (got $PROJECT)"
      exit 2
    fi
  fi

  root="${AGENTIC_PREFIX:-$HOME/.local/share/agentic-sandboxes/${CLASS}/${proj}}"
  envf="$root/agentic.env"
  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$root/bin" "$root/pi-agent" "$root/hermes-home" "$root/atop"
  fi
  write_file "$envf" "$(cat <<EOF
# Isolated agentic sandbox. class=${CLASS} project=${proj}
export AGENTIC_HOST_CLASS=${CLASS}
export AGENTIC_MODE=sandbox
export AGENTIC_PROJECT=${proj}
export AGENTIC_PREFIX=$(printf '%q' "$root")
export AGENT_SANDBOX_ROOT=$(printf '%q' "$root")
export PI_AGENT_DIR=$(printf '%q' "$root/pi-agent")
export HERMES_HOME=$(printf '%q' "$root/hermes-home")
export HERMES_AGENT_PROFILE_PATH=$(printf '%q' "$HERMES_AGENT_PROFILE_PATH")
export HERMES_PROJECT_REGISTRY_PATH=$(printf '%q' "$HERMES_PROJECT_REGISTRY_PATH")
EOF
)"$'\n'
  log "sandbox $CLASS/$proj -> $root"
}

log "class=${CLASS} plane=${AGENTIC_COSW_PLANE} mode=${MODE}${PROJECT:+ project=${PROJECT}}"

case "$MODE" in
  sandbox)
    [ -n "$PROJECT" ] || { log "ERROR: sandbox requires --project"; exit 2; }
    provision_sandbox
    ;;
  host)
    if [ "$CLASS" = personal ]; then
      provision_personal_host
    else
      provision_work_host
    fi
    if [ -n "$PROJECT" ]; then
      AGENTIC_PREFIX="${AGENTIC_PREFIX:-$HOME/.local/share/agentic-sandboxes/${CLASS}/${PROJECT}}"
      provision_sandbox
    fi
    ;;
  *)
    log "ERROR: invalid mode $MODE"
    exit 2
    ;;
esac
