#!/usr/bin/env bash
# Show non-secret Hermes toolchain status.
set -euo pipefail

HERMES_TOOLCHAIN_HOME="${HERMES_TOOLCHAIN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/hermes-toolchain}"
PNPM_HOME="${HERMES_PNPM_HOME:-$HERMES_TOOLCHAIN_HOME/pnpm}"
VENV="${HERMES_PYTHON_VENV:-$HERMES_TOOLCHAIN_HOME/venv}"
BUN_HOME="${HERMES_BUN_HOME:-$HERMES_TOOLCHAIN_HOME/bun}"
PRIVATE_DIR="${HERMES_PRIVATE_DIR:-$HOME/src/hermes}"
SHIM_DIR="${HERMES_SHIM_DIR:-$HOME/.local/bin}"
export PATH="$SHIM_DIR:$BUN_HOME/bin:$PNPM_HOME/bin:$VENV/bin:$PATH"

printf 'toolchain=%s\n' "$HERMES_TOOLCHAIN_HOME"
printf 'pnpm_home=%s\n' "$PNPM_HOME"
printf 'python_venv=%s\n' "$VENV"
printf 'bun_home=%s\n' "$BUN_HOME"
printf 'private_dir=%s\n' "$PRIVATE_DIR"
printf 'shim_dir=%s\n' "$SHIM_DIR"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/herm-fork-env.sh"
if export_herm_fork_env; then
  printf 'herm_fork=%s\n' "$HERM_TUI_FORK"
  printf 'herm_entry=%s\n' "$(herm_fork_entry)"
else
  printf 'herm_fork=missing\n'
fi
if [ -n "${HERM_TUI_FORK:-}" ] && [ -x "$SHIM_DIR/herm" ]; then
  printf 'herm_shim_points_at_fork=%s\n' "$(grep -Fq "$HERM_TUI_FORK/src/index.tsx" "$SHIM_DIR/herm" && echo yes || echo no)"
fi

for bin in hermes hermes-agent herm; do
  path="$(command -v "$bin" 2>/dev/null || true)"
  if [ -n "$path" ]; then
    printf '%s=%s\n' "$bin" "$path"
  else
    printf '%s=missing\n' "$bin"
  fi
done

for shim in hermes hermes-agent herm; do
  if [ -x "$SHIM_DIR/$shim" ]; then
    printf 'shim_%s=present\n' "$shim"
  else
    printf 'shim_%s=missing\n' "$shim"
  fi
done

if command -v hermes >/dev/null 2>&1 && hermes --help >/dev/null 2>&1; then
  printf 'hermes_help=ok\n'
else
  printf 'hermes_help=missing\n'
fi
if command -v bun >/dev/null 2>&1; then
  printf 'bun=%s\n' "$(command -v bun)"
  printf 'bun_version=%s\n' "$(bun --version 2>/dev/null || true)"
else
  printf 'bun=missing_optional_for_herm_tui\n'
fi
if command -v herm >/dev/null 2>&1 && command -v bun >/dev/null 2>&1; then
  if herm --help >/dev/null 2>&1; then
    printf 'herm_help=ok\n'
  else
    printf 'herm_help=failed\n'
  fi
fi

if [ -d "$PRIVATE_DIR/.git" ]; then
  printf 'private_repo=present\n'
  git -C "$PRIVATE_DIR" status --short --branch
else
  printf 'private_repo=missing\n'
fi

# State-lane contract: HERMES_STATE_JOURNAL_MODE honored on all code planes
# (upstream 0.18.2/0.21.0 always try WAL first — NFS rot). See
# karan.hiremath/agentic/infra/crusoe-hermes-homes.md rule 1.
if command -v python3 >/dev/null 2>&1 && [ -f "$SCRIPT_DIR/patch-nfs-journal-env.py" ]; then
  jp="$(python3 "$SCRIPT_DIR/patch-nfs-journal-env.py" --check 2>/dev/null || true)"
  if [ -n "$jp" ]; then
    planes_total="$(printf '%s' "$jp" | python3 -c 'import json,sys; d=json.load(sys.stdin); t=d.get("targets",[]); print(sum(1 for x in t if x.get("ok")), "/", len(t))' 2>/dev/null || echo unknown)"
    printf 'journal_env_patch=%s (%s planes ok)\n' "$([ "$(printf '%s' "$jp" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ok"))' 2>/dev/null)" = True ] && echo applied || echo missing)" "$planes_total"
  fi
fi
