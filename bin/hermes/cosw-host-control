#!/usr/bin/env python3
"""Allowlisted host manager for sandboxed Hermes coordination."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import signal
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_SESSIONS = SCRIPT_DIR / "project_sessions.py"
DEFAULT_STATE = Path(
    os.environ.get(
        "COSW_HOST_CONTROL_DIR",
        str(Path.home() / ".local/share/hermes-agents/chief-of-staff-work/host-control"),
    )
)
DEFAULT_SOCKET_DIR = Path(
    os.environ.get(
        "COSW_HOST_CONTROL_SOCKET_DIR",
        str(Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/hermes-{os.getuid()}")) / "hermes-sandbox-manager"),
    )
)
SCHEMA = "sandbox.manager.v1"
MAX_REQUEST_BYTES = 64 * 1024
MAX_EVENT_BYTES = 32 * 1024
ALLOWED_ACTIONS = {"ensure-pm", "ensure-pl", "event-append", "fleet-status", "notify-pm", "status"}
DENIED_KEYS = re.compile(r"(^|_)(authorization|cookie|credential|password|private_key|secret|token)(_|$)", re.I)
TRACEPARENT = re.compile(r"^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$")


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def digest(value: object) -> str:
    raw = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    return hashlib.sha256(raw).hexdigest()


def state_paths(root: Path) -> tuple[Path, Path, Path]:
    return root / "requests", root / "responses", root / "pid"


def prepare(root: Path, runtime: Path) -> None:
    requests, responses, _ = state_paths(root)
    audit = root / "audit"
    requests.mkdir(parents=True, exist_ok=True)
    responses.mkdir(parents=True, exist_ok=True)
    audit.mkdir(parents=True, exist_ok=True)
    runtime.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    requests.chmod(0o730)
    responses.chmod(0o750)
    audit.chmod(0o700)
    # XDG_RUNTIME_DIR remains private on the host. The mounted child directory
    # must be traversable by the remapped sandbox uid so it can reach the socket.
    runtime.chmod(0o711)


def project_command(*args: str) -> Any:
    proc = subprocess.run(
        [sys.executable, str(PROJECT_SESSIONS), *args],
        check=True,
        text=True,
        capture_output=True,
        timeout=15,
    )
    return json.loads(proc.stdout)


def resolve_project(project: str) -> dict[str, Any]:
    value = project_command("resolve", project)
    if not isinstance(value, dict):
        raise ValueError("project resolver returned a non-object")
    return value


def ensure(kind: str, project: str) -> dict[str, Any]:
    proc = subprocess.run(
        [sys.executable, str(PROJECT_SESSIONS), f"ensure-{kind}", project],
        check=True,
        text=True,
        capture_output=True,
        timeout=30,
    )
    return {"output": proc.stdout.strip()}


def tmux_running(name: str) -> bool:
    return bool(name) and subprocess.run(
        ["tmux", "has-session", "-t", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def notify_pm(project: str, message: str) -> dict[str, Any]:
    if not message or len(message.encode("utf-8")) > 16 * 1024:
        raise ValueError("message must be 1..16384 UTF-8 bytes")
    data = resolve_project(project)
    session = str((data.get("tmux") or {}).get("pm_session") or "")
    if not session:
        raise ValueError("project has no registered PM session")
    if not tmux_running(session):
        ensure("pm", project)
    buffer = f"cosw-host-control-{os.getpid()}-{time.time_ns()}"
    subprocess.run(["tmux", "load-buffer", "-b", buffer, "-"], input=message, text=True, check=True)
    try:
        subprocess.run(["tmux", "send-keys", "-t", f"{session}:0.0", "C-u"], check=True)
        subprocess.run(["tmux", "paste-buffer", "-b", buffer, "-d", "-t", f"{session}:0.0"], check=True)
        subprocess.run(["tmux", "send-keys", "-t", f"{session}:0.0", "Enter"], check=True)
    finally:
        subprocess.run(["tmux", "delete-buffer", "-b", buffer], check=False)
    return {"session": session, "delivered": True}


def status(project: str) -> dict[str, Any]:
    data = resolve_project(project)
    tmux = data.get("tmux") or {}
    result: dict[str, Any] = {"project": data.get("name"), "sessions": {}}
    for kind in ("pm", "pl"):
        name = str(tmux.get(f"{kind}_session") or "")
        result["sessions"][kind] = {"name": name, "running": tmux_running(name)}
    return result


def fleet_status() -> dict[str, Any]:
    rows = project_command("list")
    if not isinstance(rows, list):
        raise ValueError("project list returned a non-array")
    projects = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        pm = str(row.get("pm_session") or "")
        pl = str(row.get("pl_session") or "")
        projects.append({
            "name": str(row.get("name") or ""),
            "description": str(row.get("description") or ""),
            "pm": {"name": pm, "running": tmux_running(pm)},
            "pl": {"name": pl, "running": tmux_running(pl)},
        })
    return {"observed_at": now(), "projects": projects}


def contains_denied_key(value: object) -> bool:
    if isinstance(value, dict):
        return any(DENIED_KEYS.search(str(key)) or contains_denied_key(item) for key, item in value.items())
    if isinstance(value, list):
        return any(contains_denied_key(item) for item in value)
    return False


def event_sources(project: dict[str, Any]) -> dict[str, Path]:
    bus = project.get("event_bus") or {}
    sources: dict[str, Path] = {}
    for item in bus.get("sources") or []:
        if isinstance(item, dict) and item.get("writable", True) and item.get("key") and item.get("path"):
            sources[str(item["key"])] = Path(str(item["path"])).expanduser().resolve()
    if sources:
        return sources
    for index, item in enumerate(bus.get("publish_paths") or []):
        value = item.get("path") if isinstance(item, dict) else item
        if value:
            sources[f"publish-{index}"] = Path(str(value)).expanduser().resolve()
    return sources


def append_event(request: dict[str, Any], identity: dict[str, str]) -> dict[str, Any]:
    project = resolve_project(str(request.get("project") or ""))
    event = request.get("event")
    if not isinstance(event, dict):
        raise ValueError("event must be an object")
    if contains_denied_key(event):
        raise ValueError("event contains a denied secret-bearing key")
    if len(json.dumps(event, ensure_ascii=False).encode()) > MAX_EVENT_BYTES:
        raise ValueError("event exceeds 32768 UTF-8 bytes")
    kind = str(event.get("kind") or "")
    allowed = {str(value) for value in (project.get("event_bus") or {}).get("event_types") or []}
    if kind not in allowed:
        raise ValueError(f"event kind not registered for project: {kind}")
    sources = event_sources(project)
    source = str(request.get("source") or "")
    if not source and len(sources) == 1:
        source = next(iter(sources))
    if source not in sources:
        raise ValueError(f"event source must be one of: {sorted(sources)}")
    path = sources[source]
    path.parent.mkdir(parents=True, exist_ok=True)
    value = dict(event)
    value["project"] = project.get("name")
    value.setdefault("timestamp", now())
    value.setdefault("agent_id", identity.get("sandbox_id") or "sandboxed-hermes-agent")
    value["sandbox"] = {
        "id": identity.get("sandbox_id") or "unknown",
        "session_id": identity.get("session_id") or "unknown",
        "trace_id": identity.get("trace_id") or "",
    }
    line = json.dumps(value, separators=(",", ":"), ensure_ascii=False) + "\n"
    lock = path.with_name(path.name + ".lock")
    with lock.open("a", encoding="utf-8") as guard:
        fcntl.flock(guard.fileno(), fcntl.LOCK_EX)
        with path.open("a", encoding="utf-8") as stream:
            stream.write(line)
            stream.flush()
            os.fsync(stream.fileno())
        fcntl.flock(guard.fileno(), fcntl.LOCK_UN)
    return {"source": source, "path": str(path), "sha256": hashlib.sha256(line.encode()).hexdigest()}


def identity(request: dict[str, Any]) -> dict[str, str]:
    result = {}
    for key in ("sandbox_id", "session_id"):
        value = str(request.get(key) or "")
        if value and (len(value) > 160 or not re.fullmatch(r"[A-Za-z0-9_.:@/-]+", value)):
            raise ValueError(f"invalid {key}")
        result[key] = value
    parent = str(request.get("traceparent") or "")
    if parent and not TRACEPARENT.fullmatch(parent):
        raise ValueError("invalid traceparent")
    result["trace_id"] = parent.split("-")[1] if parent else digest({"id": request.get("id")})[:32]
    expires = str(request.get("expires_at") or "")
    if expires:
        try:
            deadline = dt.datetime.fromisoformat(expires.replace("Z", "+00:00"))
        except ValueError as exc:
            raise ValueError("invalid expires_at") from exc
        if deadline < dt.datetime.now(dt.timezone.utc):
            raise ValueError("request expired")
    return result


def handle(request: dict[str, Any]) -> dict[str, Any]:
    request_id = str(request.get("id") or "")
    action = str(request.get("action") or "")
    project = str(request.get("project") or "")
    if not request_id or len(request_id) > 128:
        raise ValueError("invalid request id")
    if action not in ALLOWED_ACTIONS:
        raise ValueError(f"action not allowed: {action}")
    if action != "fleet-status" and (not project or len(project) > 128):
        raise ValueError("invalid project")
    who = identity(request)
    if action == "ensure-pm":
        result = ensure("pm", project)
    elif action == "ensure-pl":
        result = ensure("pl", project)
    elif action == "event-append":
        result = append_event(request, who)
    elif action == "fleet-status":
        result = fleet_status()
    elif action == "notify-pm":
        result = notify_pm(project, str(request.get("message") or ""))
    else:
        result = status(project)
    return {
        "schema_version": SCHEMA,
        "id": request_id,
        "ok": True,
        "action": action,
        "project": project or None,
        "trace_id": who["trace_id"],
        "result": result,
    }


def audit(root: Path, request: dict[str, Any], response: dict[str, Any], started: float, peer_uid: int | None) -> None:
    error = str(response.get("error") or "")
    event = {
        "schema_version": SCHEMA,
        "observed_at": now(),
        "event_type": "sandbox.manager.request",
        "request_id": str(request.get("id") or response.get("id") or ""),
        "action": str(request.get("action") or "unknown"),
        "project": str(request.get("project") or "") or None,
        "sandbox_id": str(request.get("sandbox_id") or "") or None,
        "session_id": str(request.get("session_id") or "") or None,
        "trace_id": response.get("trace_id"),
        "peer_uid": peer_uid,
        "ok": bool(response.get("ok")),
        "error_kind": error.split(":", 1)[0] if error else None,
        "duration_ms": round((time.monotonic() - started) * 1000, 3),
        "request_sha256": digest(request),
    }
    path = root / "audit" / "events.jsonl"
    with path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, separators=(",", ":")) + "\n")
    path.chmod(0o600)


def process(request: dict[str, Any], root: Path, peer_uid: int | None = None) -> dict[str, Any]:
    started = time.monotonic()
    request_id = str(request.get("id") or "")
    try:
        response = handle(request)
    except Exception as exc:  # responses intentionally exclude tracebacks and secrets
        response = {
            "schema_version": SCHEMA,
            "id": request_id,
            "ok": False,
            "error": f"{type(exc).__name__}: {exc}",
        }
    audit(root, request, response, started, peer_uid)
    return response


def process_file(path: Path, root: Path, responses: Path) -> None:
    request_id = path.stem
    try:
        if path.stat().st_size > MAX_REQUEST_BYTES:
            raise ValueError("request too large")
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("request must be an object")
        response = process(raw, root)
        request_id = str(raw.get("id") or request_id)
    except Exception as exc:
        response = {"schema_version": SCHEMA, "id": request_id, "ok": False, "error": f"{type(exc).__name__}: {exc}"}
    tmp = responses / f".{request_id}.{os.getpid()}.tmp"
    final = responses / f"{request_id}.json"
    tmp.write_text(json.dumps(response, separators=(",", ":")) + "\n", encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(final)
    path.unlink(missing_ok=True)


def peer_uid(conn: socket.socket) -> int | None:
    if not hasattr(socket, "SO_PEERCRED"):
        return None
    try:
        _, uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        return uid
    except OSError:
        return None


def read_request(conn: socket.socket) -> dict[str, Any]:
    data = bytearray()
    while len(data) <= MAX_REQUEST_BYTES:
        chunk = conn.recv(min(8192, MAX_REQUEST_BYTES + 1 - len(data)))
        if not chunk:
            break
        data.extend(chunk)
        if b"\n" in chunk:
            break
    if len(data) > MAX_REQUEST_BYTES:
        raise ValueError("request too large")
    raw = json.loads(bytes(data).split(b"\n", 1)[0])
    if not isinstance(raw, dict):
        raise ValueError("request must be an object")
    return raw


def run(root: Path, runtime: Path, interval: float) -> int:
    prepare(root, runtime)
    requests, responses, pidfile = state_paths(root)
    path = runtime / "manager.sock"
    path.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    path.chmod(0o666)
    server.listen(16)
    server.settimeout(interval)
    pidfile.write_text(f"{os.getpid()}\n", encoding="utf-8")
    stop = False

    def request_stop(_signum: int, _frame: Any) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    try:
        while not stop:
            try:
                conn, _ = server.accept()
            except TimeoutError:
                conn = None
            if conn is not None:
                with conn:
                    try:
                        response = process(read_request(conn), root, peer_uid(conn))
                    except Exception as exc:
                        response = {"schema_version": SCHEMA, "id": "", "ok": False, "error": f"{type(exc).__name__}: {exc}"}
                    conn.sendall(json.dumps(response, separators=(",", ":")).encode() + b"\n")
            for item in sorted(requests.glob("*.json")):
                process_file(item, root, responses)
    finally:
        server.close()
        path.unlink(missing_ok=True)
        pidfile.unlink(missing_ok=True)
    return 0


def is_running(pidfile: Path) -> bool:
    try:
        os.kill(int(pidfile.read_text().strip()), 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("start", "run", "status", "stop"))
    parser.add_argument("--state-dir", type=Path, default=DEFAULT_STATE)
    parser.add_argument("--socket-dir", type=Path, default=DEFAULT_SOCKET_DIR)
    parser.add_argument("--interval", type=float, default=0.2)
    args = parser.parse_args()
    root = args.state_dir.expanduser().resolve()
    runtime = args.socket_dir.expanduser().resolve()
    prepare(root, runtime)
    _, _, pidfile = state_paths(root)
    if args.command == "run":
        return run(root, runtime, args.interval)
    if args.command == "status":
        print(json.dumps({"running": is_running(pidfile), "state": str(root), "socket": str(runtime / "manager.sock")}))
        return 0 if is_running(pidfile) else 1
    if args.command == "stop":
        if is_running(pidfile):
            os.kill(int(pidfile.read_text().strip()), signal.SIGTERM)
        return 0
    if is_running(pidfile):
        return 0
    log = root / "broker.log"
    with log.open("ab") as stream:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "run", "--state-dir", str(root), "--socket-dir", str(runtime), "--interval", str(args.interval)],
            stdin=subprocess.DEVNULL,
            stdout=stream,
            stderr=stream,
            start_new_session=True,
        )
    for _ in range(50):
        if is_running(pidfile) and (runtime / "manager.sock").exists():
            print(json.dumps({"running": True, "state": str(root), "socket": str(runtime / "manager.sock")}))
            return 0
        time.sleep(0.05)
    raise SystemExit("broker failed to start")


if __name__ == "__main__":
    raise SystemExit(main())
