#!/usr/bin/env python3
"""Allowlisted host broker for sandboxed CoS project-session coordination."""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_SESSIONS = SCRIPT_DIR / "project_sessions.py"
DEFAULT_STATE = Path(
    os.environ.get(
        "COSW_HOST_CONTROL_DIR",
        str(Path.home() / ".local/share/hermes-agents/chief-of-staff-work/host-control"),
    )
)
MAX_REQUEST_BYTES = 64 * 1024
ALLOWED_ACTIONS = {"ensure-pm", "ensure-pl", "notify-pm", "status"}


def state_paths(root: Path) -> tuple[Path, Path, Path]:
    return root / "requests", root / "responses", root / "pid"


def prepare(root: Path) -> None:
    requests, responses, _ = state_paths(root)
    requests.mkdir(parents=True, exist_ok=True)
    responses.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    requests.chmod(0o730)
    responses.chmod(0o750)


def resolve_project(project: str) -> dict[str, Any]:
    proc = subprocess.run(
        [sys.executable, str(PROJECT_SESSIONS), "resolve", project],
        check=True,
        text=True,
        capture_output=True,
        timeout=15,
    )
    value = json.loads(proc.stdout)
    if not isinstance(value, dict):
        raise ValueError("project resolver returned a non-object")
    return value


def ensure(kind: str, project: str) -> dict[str, Any]:
    proc = subprocess.run(
        [sys.executable, str(PROJECT_SESSIONS), f"ensure-{kind}", project],
        check=True,
        text=True,
        capture_output=True,
        timeout=30,
    )
    return {"output": proc.stdout.strip()}


def notify_pm(project: str, message: str) -> dict[str, Any]:
    if not message or len(message.encode("utf-8")) > 16 * 1024:
        raise ValueError("message must be 1..16384 UTF-8 bytes")
    data = resolve_project(project)
    session = str((data.get("tmux") or {}).get("pm_session") or "")
    if not session:
        raise ValueError("project has no registered PM session")
    exists = subprocess.run(
        ["tmux", "has-session", "-t", session],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0
    if not exists:
        ensure("pm", project)
    buffer_name = f"cosw-host-control-{os.getpid()}-{time.time_ns()}"
    subprocess.run(["tmux", "load-buffer", "-b", buffer_name, "-"], input=message, text=True, check=True)
    try:
        # PM sessions are dedicated control surfaces. Clear any stale startup
        # draft before delivering the current bounded broker message.
        subprocess.run(["tmux", "send-keys", "-t", f"{session}:0.0", "C-u"], check=True)
        subprocess.run(["tmux", "paste-buffer", "-b", buffer_name, "-d", "-t", f"{session}:0.0"], check=True)
        subprocess.run(["tmux", "send-keys", "-t", f"{session}:0.0", "Enter"], check=True)
    finally:
        subprocess.run(["tmux", "delete-buffer", "-b", buffer_name], check=False)
    return {"session": session, "delivered": True}


def status(project: str) -> dict[str, Any]:
    data = resolve_project(project)
    tmux = data.get("tmux") or {}
    result: dict[str, Any] = {"project": data.get("name"), "sessions": {}}
    for kind in ("pm", "pl"):
        name = str(tmux.get(f"{kind}_session") or "")
        running = bool(name) and subprocess.run(
            ["tmux", "has-session", "-t", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode == 0
        result["sessions"][kind] = {"name": name, "running": running}
    return result


def handle(request: dict[str, Any]) -> dict[str, Any]:
    request_id = str(request.get("id") or "")
    action = str(request.get("action") or "")
    project = str(request.get("project") or "")
    if not request_id or len(request_id) > 128:
        raise ValueError("invalid request id")
    if action not in ALLOWED_ACTIONS:
        raise ValueError(f"action not allowed: {action}")
    if not project or len(project) > 128:
        raise ValueError("invalid project")
    if action == "ensure-pm":
        result = ensure("pm", project)
    elif action == "ensure-pl":
        result = ensure("pl", project)
    elif action == "notify-pm":
        result = notify_pm(project, str(request.get("message") or ""))
    else:
        result = status(project)
    return {"id": request_id, "ok": True, "action": action, "project": project, "result": result}


def process_file(path: Path, responses: Path) -> None:
    request_id = path.stem
    response: dict[str, Any]
    try:
        if path.stat().st_size > MAX_REQUEST_BYTES:
            raise ValueError("request too large")
        raw = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("request must be an object")
        request_id = str(raw.get("id") or request_id)
        response = handle(raw)
    except Exception as exc:  # response intentionally excludes tracebacks and secrets
        response = {"id": request_id, "ok": False, "error": f"{type(exc).__name__}: {exc}"}
    tmp = responses / f".{request_id}.{os.getpid()}.tmp"
    final = responses / f"{request_id}.json"
    tmp.write_text(json.dumps(response, separators=(",", ":")) + "\n", encoding="utf-8")
    tmp.chmod(0o640)
    tmp.replace(final)
    path.unlink(missing_ok=True)


def run(root: Path, interval: float) -> int:
    prepare(root)
    requests, responses, pidfile = state_paths(root)
    pidfile.write_text(f"{os.getpid()}\n", encoding="utf-8")
    stop = False

    def request_stop(_signum: int, _frame: Any) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    try:
        while not stop:
            for path in sorted(requests.glob("*.json")):
                process_file(path, responses)
            time.sleep(interval)
    finally:
        pidfile.unlink(missing_ok=True)
    return 0


def is_running(pidfile: Path) -> bool:
    try:
        pid = int(pidfile.read_text().strip())
        os.kill(pid, 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("start", "run", "status", "stop"))
    parser.add_argument("--state-dir", type=Path, default=DEFAULT_STATE)
    parser.add_argument("--interval", type=float, default=0.5)
    args = parser.parse_args()
    root: Path = args.state_dir.expanduser().resolve()
    prepare(root)
    _, _, pidfile = state_paths(root)
    if args.command == "run":
        return run(root, args.interval)
    if args.command == "status":
        print(f"{'running' if is_running(pidfile) else 'stopped'} state={root}")
        return 0 if is_running(pidfile) else 1
    if args.command == "stop":
        if is_running(pidfile):
            os.kill(int(pidfile.read_text().strip()), signal.SIGTERM)
        return 0
    if is_running(pidfile):
        return 0
    log = root / "broker.log"
    with log.open("ab") as stream:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "run", "--state-dir", str(root), "--interval", str(args.interval)],
            stdin=subprocess.DEVNULL,
            stdout=stream,
            stderr=stream,
            start_new_session=True,
        )
    for _ in range(40):
        if is_running(pidfile):
            print(f"running state={root}")
            return 0
        time.sleep(0.05)
    raise SystemExit("broker failed to start")


if __name__ == "__main__":
    raise SystemExit(main())
