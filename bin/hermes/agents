#!/usr/bin/env bash
# Spin up isolated Hermes voice agents from declarative profiles, for day-to-day
# terminal / tmux / TUI (and messaging) use.
# Usage: agents <command> [args]
#
#   list                       List profiles (merged across the profile path)
#   resolve <profile>          Show the resolved config for a profile (host redacted)
#   new <name> [--dir D]       Scaffold a profile from TEMPLATE.
#                              D = work | personal | profile | <path> (default: personal)
#   check <profile>            Materialize + run an end-to-end endpoint health check
#   secrets-status             Cursor key cache presence (never the value)
#   secrets-refresh            Sync Cursor key from 1Password once into local cache
#   up <profile> [opts] [-- ...args]
#                              Materialize the isolated home and launch the agent
#   sessions <alias|profile>   List running tmux sessions for a seat family
#   attach <alias|profile> [s] Explicitly attach to a live TUI pane
#
# Spawn-always: `up` NEVER attaches to or switches a client toward an existing
# TUI. A busy home (one pane per home) mints the next free sibling seat via
# alias_seat.py next-seat (own HERMES_HOME + tmux session) and spawns there.
#
# Convenience wrappers:
#   cos                        agents up chief-of-staff
#   cosw                       agents up chief-of-staff-work
#   notes-m                    mobile CLI for personal-notes-steward (tmux notes:m)
#   notesw-m                   mobile CLI for work-notes-steward (work host)
#   cos-m / cosw-m / pm-m / pl-m
#   pm <project>               launch registered Hermes PM TUI in the current pane
#   pl <project>               attach registered project-lead tmux session
#       --surface cli|tui|gateway   Override the profile's default surface
#       --platform <name>           Messaging platform for surface=gateway
#       --model <name>              Launch-scoped model (writes HERMES_AGENT_LLM_MODEL)
#       --model <provider/model>    provider/ prefix splits when it names a known provider
#       --provider <name>           Launch-scoped provider (openai-codex, cursor, xai, ...)
#       --thinking <level>          Launch-scoped thinking level (low, medium, high, xhigh)
#       --host, --no-sandbox        Host-native local terminal
#       --sandbox                   Compose sandbox (work-devboxes or personal hermes-sandboxes)
#       --check                     Run an endpoint health check before launching
#       --here                      Launch the TUI in this pane
#       --force-tui                 Never attach: a busy home mints a sibling seat
#       -- <args>                   Pass remaining args through to hermes/herm
#
# Spawn-always: `up` spawns a NEW TUI every time and never steals the client.
# One pane per home: a busy home mints the next free sibling seat (own
# HERMES_HOME + tmux session) via alias_seat.py next-seat.
#
# Each agent runs under its own HERMES_HOME so it never touches ~/.hermes.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/llm-flags.sh"
if [ -f "$SCRIPT_DIR/fork-env.sh" ]; then
  # shellcheck disable=SC1091
  . "$SCRIPT_DIR/fork-env.sh"
fi
PY_BACKEND="$SCRIPT_DIR/hermes_agents.py"
TEMPLATE_SRC="$SCRIPT_DIR/profiles/TEMPLATE.yaml"
PLUGIN_DIR="$SCRIPT_DIR/plugins/cartesia"

# Resolve a `new --dir` target: keyword shorthand or a literal path.
resolve_profile_dir() {
  case "$1" in
    work)
      if [ "${AGENTIC_HOST_CLASS:-}" = personal ]; then
        echo "ERROR: work profile dir is not available on a personal host" >&2
        exit 1
      fi
      echo "$HOME/src/karan.hiremath/agentic/hermes/profiles"
      ;;
    personal) echo "$HOME/src/hermes/profiles" ;;
    profile)  echo "$SCRIPT_DIR/profiles" ;;
    *)        echo "$1" ;;
  esac
}

HERMES_TOOLCHAIN_HOME="${HERMES_TOOLCHAIN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/hermes-toolchain}"
VENV="${HERMES_PYTHON_VENV:-$HERMES_TOOLCHAIN_HOME/venv}"
PY="$VENV/bin/python"
SHIM_DIR="${HERMES_SHIM_DIR:-$HOME/.local/bin}"
export PATH="$SHIM_DIR:$VENV/bin:$PATH"

usage() { sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; }

die() { echo "ERROR: $*" >&2; exit 1; }

SEAT_PY="$SCRIPT_DIR/alias_seat.py"
CLAIM_PROFILE=""
CLAIM_TOKEN=""
release_launch_claim() {
  if [ -n "$CLAIM_PROFILE" ] && [ -n "$CLAIM_TOKEN" ]; then
    "$PY" "$SEAT_PY" release-claim "$CLAIM_PROFILE" "$$" "$CLAIM_TOKEN"
  fi
}
trap release_launch_claim EXIT

export_pin() {
  local alias_name="$1"
  local line key val
  while IFS= read -r line; do
    key="${line%%=*}"
    val="${line#*=}"
    [ -n "$key" ] || continue
    export "$key=$val"
  done < <("$PY" "$SEAT_PY" pin-env "$alias_name")
}

alias_for_profile() {
  local profile="$1"
  case "$profile" in
    chief-of-staff-work|chief-of-staff-work-*) printf '%s\n' cosw ;;
    chief-of-staff|chief-of-staff-*) printf '%s\n' cos ;;
    personal-notes-steward|personal-notes-steward-*) printf '%s\n' notes ;;
    work-notes-steward|work-notes-steward-*|notes-steward-work|notes-steward-work-*) printf '%s\n' notesw ;;
    *) printf '%s\n' "" ;;
  esac
}

attach_live_tui() {
  local profile="$1" session="${2:-}"
  local target
  if [ -n "$session" ]; then
    target="$("$PY" "$SEAT_PY" attach-target "$profile" "$session" 2>/dev/null || true)"
  else
    target="$("$PY" "$SEAT_PY" attach-target "$profile" 2>/dev/null || true)"
  fi
  [ -n "$target" ] || return 1
  echo "profile=$profile action=attach-live-tui target=$target" >&2
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$target"
  fi
  exec tmux attach-session -t "$target"
}

# Spawn-always: busy seats never steal the client. Mint the next free sibling
# seat (own HERMES_HOME + tmux session) instead. Sets MINT_PROFILE/MINT_SESSION.
mint_sibling_seat() {
  MINT_PROFILE=""
  MINT_SESSION=""
  local _next _profile _session _instance _base
  _next="$("$PY" "$SEAT_PY" next-seat "$1" "$$")" || return 1
  _profile="$(printf '%s\n' "$_next" | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("profile", ""))')"
  _session="$(printf '%s\n' "$_next" | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("session", ""))')"
  [ -n "$_profile" ] && [ -n "$_session" ] || return 1
  CLAIM_PROFILE="$_profile"
  CLAIM_TOKEN="$(printf '%s\n' "$_next" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["claim_token"])')"
  _instance="$(printf '%s\n' "$_next" | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("instance", ""))')"
  [ -n "$_instance" ] || return 1
  _base="${_profile%-$_instance}"
  MINT_PROFILE="$("$PY" "$PY_BACKEND" ensure-lane "$_base" "$_instance")" || return 1
  [ "$MINT_PROFILE" = "$_profile" ] || return 1
  MINT_SESSION="$_session"
}

# Derive per-seat runtime state from the current $profile. Sets: home,
# runtime_home, runtime_profile, alias_name, seat_session (tmux session name).
derive_runtime() {
  home="$(materialize "$profile")"
  runtime_profile="$(sed -n '1p' "$home/active_profile" 2>/dev/null || true)"
  runtime_home="$home"
  if [ -n "$runtime_profile" ] && [ "$runtime_profile" != "default" ] && [ -d "$home/profiles/$runtime_profile" ]; then
    runtime_home="$home/profiles/$runtime_profile"
  fi
  # Theme mutation must target the claimed seat, not an inherited busy home.
  if [ -x "$SCRIPT_DIR/apply-nighttide-theme" ]; then
    HERMES_HOME="$runtime_home" HERMES_PROFILE="$profile" "$SCRIPT_DIR/apply-nighttide-theme" --quiet || true
  fi
  alias_name="$(alias_for_profile "$profile")"
  if [ -n "$alias_name" ]; then
    "$PY" "$SEAT_PY" write-seat "$profile" "$alias_name" >/dev/null
    export_pin "$profile"
  fi
  if type hermes_ensure_short_home >/dev/null 2>&1; then
    runtime_home="$(hermes_ensure_short_home "$profile" "$runtime_home")"
  fi
  seat_session="$("$PY" "$SEAT_PY" resolve-profile "$profile" 2>/dev/null | sed -n 's/.*"session": *"\([^"]*\)".*/\1/p' || true)"
  [ -n "$seat_session" ] || seat_session="${alias_name:-$profile}"
  echo "profile=$profile surface=$surface home=$home runtime_home=$runtime_home alias=${alias_name:-none} session=$seat_session"
}

ensure_profile_sandbox() {
  local profile="$1"
  local work="${COSW_WORK_DEVBOX:-$HOME/src/karan.hiremath/agentic/hermes/sandboxes/work-devbox}"
  local personal="${COS_PERSONAL_DEVBOX:-$HOME/src/hermes/sandboxes/personal-devbox}"
  if [ -e "$work" ] && "$work" has "$profile"; then
    "$work" ensure "$profile"
    return 0
  fi
  if [ -e "$personal" ] && "$personal" has "$profile"; then
    "$personal" ensure "$profile"
    return 0
  fi
  die "no sandbox stack for profile: $profile (try: cosw-s ls or cos-s ls)"
}

[ -x "$PY" ] || die "Hermes venv python missing ($PY); run bin/hermes/install first"

materialize() {
  "$PY" "$PY_BACKEND" materialize "$1"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  -h|--help|help|"") usage; exit 0 ;;

  list)
    "$PY" "$PY_BACKEND" list
    ;;

  resolve)
    [ "$#" -ge 1 ] || die "resolve needs a profile name"
    "$PY" "$PY_BACKEND" resolve "$1"
    ;;

  sessions)
    [ "$#" -ge 1 ] || die "usage: agents sessions <alias-or-profile>"
    exec "$PY" "$SEAT_PY" sessions "$1"
    ;;

  attach)
    [ "$#" -ge 1 ] || die "usage: agents attach <alias-or-profile> [session]"
    "$PY" "$SEAT_PY" attach-target "$1" "${2:-}" >/dev/null 2>&1 \
      || die "no live TUI pane for $1 (list: agents sessions $1)"
    attach_live_tui "$1" "${2:-}"
    ;;

  new)
    [ "$#" -ge 1 ] || die "new needs a name"
    name="$1"; shift
    target="personal"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dir) target="${2:?}"; shift 2 ;;
        *) die "unknown option: $1" ;;
      esac
    done
    dir="$(resolve_profile_dir "$target")"
    mkdir -p "$dir"
    dst="$dir/$name.yaml"
    [ -e "$dst" ] && die "profile already exists: $dst"
    sed "s/^name: TEMPLATE/name: $name/" "$TEMPLATE_SRC" > "$dst"
    echo "created $dst ($(resolve_profile_dir "$target" >/dev/null && echo "$target"))"
    echo "edit it, then: agents check $name"
    ;;

  check)
    [ "$#" -ge 1 ] || die "check needs a profile name"
    home="$(materialize "$1")"
    echo "home=$home"
    HERMES_HOME="$home" "$PY" "$PLUGIN_DIR/validate.py" --tts --stt
    ;;

  secrets-status)
    "$PY" "$PY_BACKEND" secrets-status
    ;;

  secrets-refresh)
    "$PY" "$PY_BACKEND" secrets-refresh
    ;;

  up)
    [ "$#" -ge 1 ] || die "up needs a profile name"
    profile="$1"; shift
    surface=""; platform=""; do_check=0; model=""; provider=""; thinking=""; sandbox=""; here=0; force_tui=0; passthrough=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --surface) surface="${2:?}"; shift 2 ;;
        --platform) platform="${2:?}"; shift 2 ;;
        --model) model="${2:?}"; shift 2 ;;
        --provider) provider="${2:?}"; shift 2 ;;
        --thinking) thinking="${2:?}"; shift 2 ;;

        --host|--host-tools|--no-sandbox) sandbox="host"; shift ;;
        --sandbox|--docker) sandbox="sandbox"; shift ;;
        --check) do_check=1; shift ;;
        --here) here=1; shift ;;
        --force-tui) force_tui=1; shift ;;
        --) shift; passthrough=("$@"); break ;;
        *) die "unknown option: $1" ;;
      esac
    done
    if [ "$sandbox" = "host" ]; then
      export HERMES_AGENT_TERMINAL_BACKEND=local
      export TERMINAL_ENV=local
    elif [ "$sandbox" = "sandbox" ]; then
      export HERMES_AGENT_TERMINAL_BACKEND=docker
      export TERMINAL_ENV=docker
      export TERMINAL_DOCKER_PERSIST_ACROSS_PROCESSES="${TERMINAL_DOCKER_PERSIST_ACROSS_PROCESSES:-true}"
      ensure_profile_sandbox "$profile"
    fi
    if [ -n "$provider" ]; then
      export HERMES_AGENT_LLM_PROVIDER="$provider"
      export HERMES_INFERENCE_PROVIDER="$provider"
      export HERMES_TUI_PROVIDER="$provider"
    fi
    if [ -n "$model" ]; then
      # Split provider/model when the prefix names a known provider so
      # together/zai-org/GLM-5.3-Flash-style ids pin both halves.
      llm_flags_split "$model"
      if [ -n "$LLM_SPLIT_PROVIDER" ]; then
        if [ -n "$provider" ] && [ "$provider" != "$LLM_SPLIT_PROVIDER" ]; then
          die "conflicting --provider $provider vs --model $model"
        fi
        [ -n "$provider" ] || provider="$LLM_SPLIT_PROVIDER"
        model="$LLM_SPLIT_MODEL"
      fi

      export HERMES_AGENT_LLM_MODEL="$model"
      export HERMES_INFERENCE_MODEL="$model"
      export HERMES_MODEL="$model"
    fi
    if [ -n "$thinking" ]; then
      export HERMES_AGENT_LLM_THINKING="$thinking"
    fi
    # Cursor SDK on Mini rejects grok-4.6:fast. Strip the thinking suffix.
    case "${HERMES_MODEL:-}" in
      grok-4.6:fast|grok-4.6:*)
        export HERMES_AGENT_LLM_MODEL=grok-4.6
        export HERMES_INFERENCE_MODEL=grok-4.6
        export HERMES_MODEL=grok-4.6
        ;;
    esac

    # Default surface from the profile if not overridden.
    [ -n "$surface" ] || surface="$("$PY" "$PY_BACKEND" resolve "$profile" | sed -n 's/.*"surface": *"\([^"]*\)".*/\1/p')"
    [ -n "$surface" ] || surface="cli"

    # Claim before ANY materialization or config/theme mutation. Mobile launches
    # hand us a reserved seat even for their CLI fallback.
    if [ "$surface" = "tui" ] || [ -n "${HERMES_SEAT_CLAIM_TOKEN:-}" ]; then
      seat_session="$("$PY" "$SEAT_PY" resolve-profile "$profile" 2>/dev/null | sed -n 's/.*"session": *"\([^"]*\)".*/\1/p' || true)"
      [ -n "$seat_session" ] || seat_session="$profile"
      if [ -n "${HERMES_SEAT_CLAIM_TOKEN:-}" ]; then
        [ "${HERMES_SEAT_CLAIM_PROFILE:-}" = "$profile" ] || die "claim profile mismatch"
        CLAIM_TOKEN="$("$PY" "$SEAT_PY" claim "$profile" "$$" "$HERMES_SEAT_CLAIM_TOKEN")" \
          || die "cannot transfer reserved seat $profile"
        CLAIM_PROFILE="$profile"
      elif { [ "$here" -eq 0 ] && [ -z "${TMUX:-}" ] \
          && command -v tmux >/dev/null 2>&1 \
          && tmux has-session -t "$seat_session" 2>/dev/null; } \
          || ! CLAIM_TOKEN="$("$PY" "$SEAT_PY" claim "$profile" "$$")"; then
        mint_sibling_seat "$profile" || die "$profile busy and no free sibling seat"
        echo "spawn-always: $profile busy; minted sibling seat $MINT_PROFILE (session $MINT_SESSION)" >&2
        profile="$MINT_PROFILE"
      else
        CLAIM_PROFILE="$profile"
      fi
      unset HERMES_SEAT_CLAIM_TOKEN HERMES_SEAT_CLAIM_PROFILE
    fi

    derive_runtime

    if [ "$do_check" -eq 1 ]; then
      HERMES_HOME="$runtime_home" "$PY" "$PLUGIN_DIR/validate.py" --tts --stt || die "endpoint health check failed; not launching"
    fi

    export HERMES_HOME="$runtime_home"
    if [ "$surface" = "tui" ] && [ "$here" -eq 0 ] && [ -n "$alias_name" ] \
        && [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
      # The child gets only this seat's capability. The parent retains its claim
      # until the child adopts it; failed tmux creation releases only our owner.
      build_cmd=(env "HERMES_SEAT_CLAIM_PROFILE=$CLAIM_PROFILE" "HERMES_SEAT_CLAIM_TOKEN=$CLAIM_TOKEN"
        "$0" up "$profile" --surface tui --here)
      [ ${#passthrough[@]} -eq 0 ] || build_cmd+=(-- "${passthrough[@]}")
      tmux new-session -d -s "${HERMES_ALIAS_SESSION:-$seat_session}" -n 0 "${build_cmd[@]}"
      "$PY" "$SEAT_PY" wait-transfer "$CLAIM_PROFILE" "$$" "$CLAIM_TOKEN"
      exec tmux attach-session -t "${HERMES_ALIAS_SESSION:-$seat_session}"
    fi
    if [ -n "$CLAIM_TOKEN" ]; then
      "$PY" "$SEAT_PY" activate-claim "$profile" "$$" "$CLAIM_TOKEN" "$runtime_home"
    fi
    # Cursor SDK reads process env, not only HERMES_HOME/.env. Export without echoing.
    if [ -f "$runtime_home/.env" ]; then
      _cursor_key="$(sed -n 's/^CURSOR_API_KEY=//p' "$runtime_home/.env" | tail -n 1 || true)"
      if [ -n "${_cursor_key:-}" ]; then
        export CURSOR_API_KEY="$_cursor_key"
        launchctl setenv CURSOR_API_KEY "$_cursor_key" 2>/dev/null || true
      fi
      unset _cursor_key
    fi
    resolve_herm() {
      if [ -x "$HOME/src/herm/src/index.tsx" ] && [ -x "$HOME/.local/bin/herm" ]; then
        printf '%s\n' "$HOME/.local/bin/herm"
        return 0
      fi
      if [ -x "$HOME/src/herm/src/index.tsx" ]; then
        printf '%s\n' "$HOME/src/herm/src/index.tsx"
        return 0
      fi
      command -v herm
    }

    case "$surface" in
      cli)
        command -v hermes >/dev/null 2>&1 || die "hermes not on PATH"
        if [ -n "$CLAIM_TOKEN" ]; then
          "$PY" "$SEAT_PY" run-claim "$profile" "$$" "$CLAIM_TOKEN" "$runtime_home" \
            hermes chat "${passthrough[@]+"${passthrough[@]}"}"
          exit $?
        fi
        exec hermes chat "${passthrough[@]+"${passthrough[@]}"}"
        ;;
      tui)
        herm_bin="$(resolve_herm)" || die "herm (TUI) not installed; run bin/hermes/install-tui"
        # The helper gates exec on atomic PID ownership and cleans up only
        # this generation after the real TUI PID exits, including failed exec.
        "$PY" "$SEAT_PY" run-claim "$profile" "$$" "$CLAIM_TOKEN" "$runtime_home" \
          "$herm_bin" "${passthrough[@]+"${passthrough[@]}"}"
        exit $?
        ;;
      gateway)
        command -v hermes >/dev/null 2>&1 || die "hermes not on PATH"
        [ -n "$platform" ] && export HERMES_GATEWAY_PLATFORM="$platform"
        echo "Launching gateway (platform: ${platform:-from config}). Configure tokens in $home/.env"
        echo "First time? run:  HERMES_HOME=$home hermes gateway setup"
        exec hermes gateway run "${passthrough[@]+"${passthrough[@]}"}"
        ;;
      *) die "unknown surface: $surface (use cli|tui|gateway)" ;;
    esac
    ;;

  *) die "unknown command: $cmd (try: agents help)" ;;
esac
