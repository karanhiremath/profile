#!/usr/bin/env bash
# Print shell exports for the isolated Hermes toolchain.
set -euo pipefail

HERMES_TOOLCHAIN_HOME="${HERMES_TOOLCHAIN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/hermes-toolchain}"
PNPM_HOME="${HERMES_PNPM_HOME:-$HERMES_TOOLCHAIN_HOME/pnpm}"
VENV="${HERMES_PYTHON_VENV:-$HERMES_TOOLCHAIN_HOME/venv}"
BUN_HOME="${HERMES_BUN_HOME:-$HERMES_TOOLCHAIN_HOME/bun}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/herm-fork-env.sh"
export_herm_fork_env || true
if [ -f "$SCRIPT_DIR/fork-env.sh" ]; then
  # shellcheck disable=SC1091
  . "$SCRIPT_DIR/fork-env.sh"
fi

cat <<EOF
export HERMES_TOOLCHAIN_HOME="$HERMES_TOOLCHAIN_HOME"
export PNPM_HOME="$PNPM_HOME"
export HERM_TUI_FORK="${HERM_TUI_FORK:-}"
export HERMES_HERM_TUI_DIR="${HERMES_HERM_TUI_DIR:-}"
export AGENT_SHARED_HOME="${AGENT_SHARED_HOME:-}"
export HERMES_SHARED_PEOPLE_HOME="${HERMES_SHARED_PEOPLE_HOME:-}"
export HERMES_AGENTS_DATA_HOME="${HERMES_AGENTS_DATA_HOME:-}"
export HERMES_STATE_JOURNAL_MODE="${HERMES_STATE_JOURNAL_MODE:-}"
export HERMES_KANBAN_HOME="${HERMES_KANBAN_HOME:-}"
export PATH="$BUN_HOME/bin:$PNPM_HOME/bin:$VENV/bin:\$PATH"
EOF
