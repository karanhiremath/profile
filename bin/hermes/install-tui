#!/usr/bin/env bash
# Install/upgrade only the herm OpenTUI package and relink Hermes entrypoints.
#
# Usage: install-tui [--help]

set -euo pipefail

case "${1:-}" in
  -h|--help|help)
    cat <<'EOF'
Install/upgrade only the herm OpenTUI package and relink Hermes entrypoints.

Usage: install-tui [--help]
EOF
    exit 0
    ;;
esac

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec "${script_dir}/install" --tui-only "$@"
