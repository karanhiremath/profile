#!/usr/bin/env python3
"""Install and select Karan's Nighttide Herm TUI themes.

Keeps Herm's visual theme aligned with ~/src/profile/bin/ghostty/config.
The dark background is the exact Ghostty background (#2e3d4e). Accent is
the host/profile identity cue:

  this MBP Cos          nighttide-violet
  home-mac-mini Cos     nighttide-teal
  mac-mbp-13 Cos        nighttide-blue
  omarchy-mbp-13 Cos    nighttide-amber
  qemu omarchy Cos      nighttide-green
  work / cosw           nighttide-ember

Safe to rerun after `herm-tui` upgrades. Writes theme JSON into:
  1. the active herm-tui package `themes/` dir (published installs)
  2. each Hermes home's `herm/themes/` (user-theme overlay; fork + package)
and patches the package theme registry when `index.js` is present.

Preserves unrelated Herm preferences (eikon, kanban, never-prompts,
lastSessionId). Existing nighttide-* selections on non-Cos homes are kept.
Cos personal homes are remapped to the host accent so a prior installer
stomp (personal/ares) can be repaired.

Usage: apply-nighttide-theme [--dry-run] [--force]
"""
from __future__ import annotations

import argparse
import json
import os
import re
import socket
import subprocess
import sys
from pathlib import Path

HOME = Path.home()


def _under_root(root: Path) -> Path | None:
    """Given a pnpm global root, return the herm-tui dir if present.

    `pnpm root -g` may return either the global node_modules dir or its parent
    (layout differs across pnpm versions, e.g. v11 -> $PNPM_HOME/global/v11), so
    check both `<root>/herm-tui` and `<root>/node_modules/herm-tui`.
    """
    candidates = [root / "herm-tui", root / "node_modules" / "herm-tui"]
    # pnpm v11 may place global packages under a hash/project directory.
    candidates.extend(sorted(root.glob("*/herm-tui")))
    candidates.extend(sorted(root.glob("*/node_modules/herm-tui")))
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def _herm_tui_dir() -> Path:
    """Locate the active herm-tui install/source directory.

    Resolution order:
      1. HERMES_HERM_TUI_DIR (install-tui exports this; may be ~/src/herm)
      2. HERMES_PNPM_GLOBAL_ROOT / `pnpm root -g`
      3. toolchain-local pnpm global store
      4. legacy npm-global install used by older profile shims
      5. local fork checkout at ~/src/herm
    """
    direct_env = os.environ.get("HERMES_HERM_TUI_DIR")
    if direct_env and Path(direct_env).exists():
        return Path(direct_env)

    root_env = os.environ.get("HERMES_PNPM_GLOBAL_ROOT")
    if root_env:
        found = _under_root(Path(root_env))
        if found:
            return found
    try:
        root = subprocess.run(
            ["pnpm", "root", "-g"], capture_output=True, text=True, check=True
        ).stdout.strip()
        if root:
            found = _under_root(Path(root))
            if found:
                return found
    except (OSError, subprocess.CalledProcessError):
        pass
    pnpm_home = Path(
        os.environ.get("HERMES_PNPM_HOME", HOME / ".local/share/hermes-toolchain/pnpm")
    )
    matches = sorted(pnpm_home.glob("global/*/herm-tui")) + sorted(
        pnpm_home.glob("global/*/node_modules/herm-tui")
    )
    if matches:
        return matches[-1]

    toolchain = Path(os.environ.get("HERMES_TOOLCHAIN_HOME", HOME / ".local/share/hermes-toolchain"))
    npm_home = Path(os.environ.get("HERMES_NPM_HOME", toolchain / "npm"))
    legacy = npm_home / "lib/node_modules/herm-tui"
    if legacy.exists():
        return legacy

    local_fork = HOME / "src/herm"
    if local_fork.exists():
        return local_fork
    return pnpm_home / "global/v11/node_modules/herm-tui"


