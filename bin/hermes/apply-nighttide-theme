def theme_json(name: str) -> str:
    accent, primary, line_color = THEME_VARIANTS[name]
    return json.dumps(nighttide_theme(accent, primary=primary, line_color=line_color), indent=2) + "\n"


def write_theme_dir(dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    for name in THEME_VARIANTS:
        (dest / f"{name}.json").write_text(theme_json(name))


def herm_fork_dirs() -> list[Path]:
    """Fork checkouts that Cos actually execs (often not the pnpm/npm package)."""
    found: list[Path] = []
    seen: set[Path] = set()
    candidates = []
    env = os.environ.get("HERMES_HERM_TUI_DIR")
    if env:
        candidates.append(Path(env))
    candidates.append(HOME / "src/herm")
    if HERM_TUI.exists():
        candidates.append(HERM_TUI)
    for raw in candidates:
        try:
            key = raw.resolve()
        except FileNotFoundError:
            continue
        if key in seen:
            continue
        if (key / "src/theme/themes").is_dir() and (key / "src/theme/manifest.ts").exists():
            seen.add(key)
            found.append(key)
    return found


def _preview_entry(name: str) -> str:
    accent, primary, _line = THEME_VARIANTS[name]
    return (
        f'  "{name}": {{ primary: "{primary}", accent: "{accent}", '
        f'background: "{TRANSPARENT}" }},'
    )


def ensure_fork_manifest(manifest: Path) -> None:
    text = manifest.read_text()
    changed = False
    for name in THEME_VARIANTS:
        entry = _preview_entry(name)
        token = f'"{name}":'
        pattern = (
            rf'  "{re.escape(name)}": \{{ primary: "#[0-9A-Fa-f]{{6}}", '
            rf'accent: "#[0-9A-Fa-f]{{6}}", background: "(?:#[0-9A-Fa-f]{{6}}|transparent)" \}},'
        )
        if token in text:
            text, n = re.subn(pattern, entry, text, count=1)
            changed = changed or bool(n)
            continue
        anchor = '  "nighttide-violet":' if '"nighttide-violet":' in text else '  "nighttide":'
        idx = text.find(anchor)
        if idx < 0:
            raise SystemExit(f"could not patch herm fork manifest: {manifest}")
        line_end = text.find("\n", idx)
        insert_at = line_end + 1 if line_end >= 0 else idx
        text = text[:insert_at] + entry + "\n" + text[insert_at:]
        changed = True
    if changed:
        manifest.write_text(text)


def write_fork_themes() -> list[str]:
    """Older herm forks have no user-theme loader; Cos falls back to tokyonight
    unless nighttide-* exists in src/theme/themes + manifest PREVIEW."""
    written = []
    for fork in herm_fork_dirs():
        dest = fork / "src/theme/themes"
        write_theme_dir(dest)
        ensure_fork_manifest(fork / "src/theme/manifest.ts")
        written.append(str(dest))
    return written


def write_package_themes() -> str | None:
    """Write into a published herm-tui package. Skip dirtying a local fork."""
    if (HERM_TUI / "src/theme/themes").is_dir():
        return None
    if not HERM_TUI.exists():
        return None
    write_theme_dir(THEMES)
    return str(THEMES)


def ensure_registry() -> None:
    if not INDEX.exists():
        return
    text = INDEX.read_text(errors="ignore")
    entries = {
        name: f'{name if "-" not in name else json.dumps(name)}:'
        f'{{primary:"{primary}",accent:"{accent}",background:"{TRANSPARENT}"}},'
        for name, (accent, primary, _line_color) in THEME_VARIANTS.items()
    }

    changed = False
    for name, entry in entries.items():
        token = f"{name}:{{" if "-" not in name else f'"{name}":{{'
        if token in text:
            text, n = re.subn(
                re.escape(token)
                + r'primary:"#[0-9A-Fa-f]{6}",accent:"#[0-9A-Fa-f]{6}",background:"(?:#[0-9A-Fa-f]{6}|transparent)"\},',
                entry,
                text,
                count=1,
            )
            changed = changed or bool(n)
            continue
        insert_after = (
            entries["nighttide"]
            if "nighttide:{" in text
            else 'nightowl:{primary:"#82AAFF",accent:"#c792ea",background:"#011627"},'
        )
        if insert_after not in text:
            raise SystemExit("could not patch herm-tui theme registry: insertion point missing")
        text = text.replace(insert_after, insert_after + entry, 1)
        changed = True

    if changed:
        INDEX.write_text(text)


def is_work_home(home: Path) -> bool:
    parts = {part.lower() for part in home.parts}
    name = home.name.lower()
    return (
        "chief-of-staff-work" in parts
        or name == "hwork"
        or name.startswith("work-")
        or name.endswith("-work")
        or (name == "work" and "profiles" in parts)
    )


def is_cos_home(home: Path) -> bool:
    if is_work_home(home):
        return False
    parts = {part.lower() for part in home.parts}
    name = home.name.lower()
    return "chief-of-staff" in parts or name in {"hpersonal", "cos"}


def existing_theme(home: Path) -> str | None:
    path = home / "herm" / "tui.json"
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    theme = data.get("theme")
    return theme if isinstance(theme, str) and theme else None


def theme_for_home(home: Path, *, force: bool = False) -> str:
    if is_work_home(home):
        return "nighttide-ember"
    if is_cos_home(home):
        return host_cos_theme()
    current = existing_theme(home)
    if not force and current and current in THEME_VARIANTS:
        return current
    return "nighttide-personal"


def merge_pref(home: Path, *, force: bool = False) -> str:
    path = home / "herm" / "tui.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}
    theme = theme_for_home(home, force=force)
    data.update({"theme": theme, "themeMode": "dark"})
    if is_cos_home(home):
        if not data.get("eikon"):
            data["eikon"] = COS_IDENTITY["eikon"]
        if not isinstance(data.get("identity"), dict):
            data["identity"] = dict(COS_IDENTITY["identity"])
    path.write_text(json.dumps(data, indent=2) + "\n")
    return theme


def candidate_homes() -> list[Path]:
    homes = [HOME / ".hermes"]

    profiles = HOME / ".hermes" / "profiles"
    if profiles.exists():
        homes.extend(p for p in profiles.iterdir() if p.is_dir())

    agents = HOME / ".local/share/hermes-agents"
    if agents.exists():
        for dirpath, _dirnames, _filenames in os.walk(agents, onerror=lambda _e: None):
            d = Path(dirpath)
            try:
                if (d / "config.yaml").exists() or (d / "SOUL.md").exists():
                    homes.append(d)
            except OSError:
                continue

    seen = set()
    ordered = []
    for home in homes:
        try:
            key = home.resolve()
        except FileNotFoundError:
            continue
        if key in seen:
            continue
        seen.add(key)
        ordered.append(home)
    return ordered


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    p.add_argument("--dry-run", action="store_true", help="print planned actions only")
    p.add_argument(
        "--force",
        action="store_true",
        help="remap non-Cos homes even when they already have a nighttide-* theme",
    )
    p.add_argument("--quiet", action="store_true", help="suppress per-home listing")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    if args.dry_run:
        print(f"herm-tui={HERM_TUI}")
        print(f"machine={machine_id()} cos={host_cos_theme()}")
        print(f"package_themes={'skip-fork' if (HERM_TUI / 'src/theme/themes').is_dir() else THEMES}")
        print(f"forks={[str(p) for p in herm_fork_dirs()]}")
        for home in candidate_homes():
            print(f"  {home}: {theme_for_home(home, force=args.force)}")
        return 0

    if not HERM_TUI.exists() and not candidate_homes() and not herm_fork_dirs():
        raise SystemExit(f"herm-tui install not found: {HERM_TUI}")

    package_dir = write_package_themes()
    if package_dir:
        ensure_registry()
    forks = write_fork_themes()

    applied = []
    for home in candidate_homes():
        write_theme_dir(home / "herm" / "themes")
        theme = merge_pref(home, force=args.force)
        applied.append(f"{home}: {theme}")

    if not args.quiet:
        print(f"nighttide themes installed with Ghostty background {GHOSTTY_BG}")
        print(f"  machine={machine_id()} cos={host_cos_theme()}")
        if package_dir:
            print(f"  package={package_dir}")
        for fork in forks:
            print(f"  fork={fork}")
        for line in applied:
            print(f"  {line}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
