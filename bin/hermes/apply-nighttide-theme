def machine_id() -> str:
    explicit = os.environ.get("HERMES_MACHINE_PROFILE", "").strip()
    if explicit:
        return explicit.lower()
    try:
        return socket.gethostname().split(".")[0].lower()
    except OSError:
        return ""


def host_cos_theme(mid: str | None = None) -> str:
    name = (mid if mid is not None else machine_id()).lower()
    for prefix, theme in COS_HOST_PREFIXES:
        if name == prefix or name.startswith(prefix):
            return theme
    return "nighttide-violet"


