#!/usr/bin/env bash
# Opt-in work sandbox door. Host CosW stays `cosw`.
#   cosw-s ls
#   cosw-s <sandbox> [<instance>] [cosw-or-agents args]
# Instance omitted → unique id. A token starting with - is a flag.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

log() { printf 'cosw-s: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  cosw-s ls
  cosw-s <sandbox-name> [<instance>] [cosw-or-agents args]

Host CosW is `cosw`. This command is the sandbox door.

Examples:
  cosw-s ls
  cosw-s cosw
  cosw-s cosw monday-eop
  cosw-s cosw --codex
  cosw-s librarian
EOF
}

work_devbox_cmd() {
  local candidate="${COSW_WORK_DEVBOX:-$HOME/src/karan.hiremath/agentic/hermes/sandboxes/work-devbox}"
  [ -e "$candidate" ] || die "work-devbox helper missing: $candidate"
  printf '%s\n' "$candidate"
}

unique_instance() {
  local sandbox="$1"
  printf '%s-%s-%s\n' "$sandbox" "$(date -u +%Y%m%dT%H%M%SZ)" "$(openssl rand -hex 2 2>/dev/null || printf '%04x' "$$")"
}

cmd="${1:-ls}"
case "$cmd" in
  -h|--help|help)
    usage
    exit 0
    ;;
  ls|list)
    exec "$(work_devbox_cmd)" ls
    ;;
esac

devbox="$(work_devbox_cmd)"
profile="$("$devbox" resolve-sandbox "$cmd" --field profile)" || exit 1
launch="$("$devbox" resolve-sandbox "$cmd" --field launch)" || exit 1
container="$("$devbox" resolve-sandbox "$cmd" --field container)" || exit 1
shift

instance=""
if [ "${1:-}" != "" ] && [ "${1#-}" = "$1" ]; then
  instance="$1"
  shift
fi
if [ -z "$instance" ]; then
  instance="$(unique_instance "$cmd")"
fi

"$devbox" ensure "$profile"
export COSW_SANDBOX_CONTAINER="$container"
export HERMES_SANDBOX_CONTAINER="$container"
export COSW_SANDBOX_INSTANCE="$instance"
export HERMES_SANDBOX_INSTANCE="$instance"
log "sandbox=$cmd instance=$instance profile=$profile"

if [ "$launch" = "cosw" ]; then
  exec "$SCRIPT_DIR/cosw" --sandbox "$@"
fi
exec "$SCRIPT_DIR/agents" up "$profile" --sandbox "$@"
