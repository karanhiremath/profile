# Copy to ~/.local/share/hostctl/omarchy.env (mode 600).
# Optional. Bind uses op-keychain by default (no 1Password popup).
# Set OMARCHY_SYNC_OP_VAULT=1 only when you want `op` vault SSH Key public keys too.

OMARCHY_OP_ACCOUNT=my.1password.com
OMARCHY_OP_SSH_VAULT=Personal
# Optional extra newline-separated public keys:
# OMARCHY_SSH_AUTHORIZED_KEYS_OP_REF=op://Personal/<item>/public_keys
# Optional cidata autoinstall password hash (openssl passwd -6). Never commit.
# OMARCHY_ISO_PASSWORD_HASH='$6$...'
