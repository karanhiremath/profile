#!/bin/bash
# tmux-connect — SSH to a host and attach/create a tmux session
#
# Usage:
#   tmux-connect                        # fzf picker from host registry
#   tmux-connect <host>                 # connect with default session
#   tmux-connect <host> <session>       # connect with specific session
#   tmux-connect --ls [host]            # list attachable tmux sessions (default: local)
#   tmux-connect <host> --ls            # same, for a registered host
#   tmux-connect --ls-cache [host]      # print cached session names (completions)
#   tmux-connect --sandbox --ls [host]  # list running user podman sandboxes
#   tmux-connect --sandbox <host> --ls  # same
#   tmux-connect --sandbox <host> <box> # attach/create tmux session "home" in sandbox
#   tmux-connect --sandbox <host> <box> <session>
#   tmux-connect --sandbox <host> <box> --ls   # list tmux sessions in sandbox
#   tmux-connect --list                 # list registered hosts
#   tmux-connect --status               # check which hosts have active sessions
#   tmux-connect --help                 # show help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REGISTRY="${SCRIPT_DIR}/hosts/registry.conf"
# Work-specific host registries (loaded in order, later entries win)
EXTRA_REGISTRIES="${TMUX_CONNECT_EXTRA_REGISTRIES:-}"

usage() {
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    printf '%s\n' \
        'tmux-connect --new-argv <host> <session> --cwd <absolute> [--alias <name>] [--profile <name>] [--request-id <id>] [--timeout <1..60>] -- <absolute-executable> [argv...]' \
        'tmux-connect --sandbox --new-argv <host> <sandbox> <session> --cwd <absolute> -- <absolute-executable> [argv...]' \
        'new-argv is direct execution; it does not initialize interactive ZSH.'
}

SESSION_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-connect/sessions"
SANDBOX_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-connect/sandboxes"

session_cache_file() {
    local host="${1:-local}"
    host="${host//\//_}"
    printf '%s/%s\n' "$SESSION_CACHE_DIR" "$host"
}

write_session_cache() {
    local host="$1"
    local file
    file="$(session_cache_file "$host")"
    mkdir -p "$SESSION_CACHE_DIR"
    cat > "$file"
}

cmd_ls_cache() {
    local file
    file="$(session_cache_file "${1:-local}")"
    if [[ -f "$file" ]]; then
        cat "$file"
    fi
}

sandbox_cache_file() {
    local host="${1:-local}"
    host="${host//\//_}"
    printf '%s/%s\n' "$SANDBOX_CACHE_DIR" "$host"
}

sandbox_session_cache_file() {
    local host="${1:-local}" sandbox="${2:-}"
    host="${host//\//_}"
    sandbox="${sandbox//\//_}"
    printf '%s/%s--%s\n' "$SESSION_CACHE_DIR" "$host" "$sandbox"
}

write_sandbox_cache() {
    local host="$1"
    local file
    file="$(sandbox_cache_file "$host")"
    mkdir -p "$SANDBOX_CACHE_DIR"
    cat > "$file"
}

write_sandbox_session_cache() {
    local host="$1" sandbox="$2"
    local file
    file="$(sandbox_session_cache_file "$host" "$sandbox")"
    mkdir -p "$SESSION_CACHE_DIR"
    cat > "$file"
}

cmd_sandbox_ls_cache() {
    local host="${1:-local}" sandbox="${2:-}"
    local file
    if [[ -n "$sandbox" ]]; then
        file="$(sandbox_session_cache_file "$host" "$sandbox")"
    else
        file="$(sandbox_cache_file "$host")"
    fi
    if [[ -f "$file" ]]; then
        cat "$file"
    fi
}

valid_tmux_ident() {
    [[ "$1" =~ ^[A-Za-z0-9._:@-]+$ ]]
}

# All registry files (base + extras)
all_registries() {
    echo "$REGISTRY"
    if [ -n "$EXTRA_REGISTRIES" ]; then
        echo "$EXTRA_REGISTRIES" | tr ':' '\n'
    fi
}

# Parse all registries into entries
load_registry() {
    local entries=()
    for reg in $(all_registries); do
        [ -f "$reg" ] || continue
        while IFS= read -r line; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            entries+=("$line")
        done < "$reg"
    done
    printf '%s\n' "${entries[@]}"
}

get_host_field() {
    local name="$1" field="$2"
    for reg in $(all_registries); do
        [ -f "$reg" ] || continue
        while IFS='|' read -r h_name h_ssh h_session h_desc; do
            [[ -z "$h_name" || "$h_name" == \#* ]] && continue
            if [[ "$h_name" == "$name" ]]; then
                case "$field" in
                    ssh) echo "$h_ssh" ;;
                    session) echo "$h_session" ;;
                    desc) echo "$h_desc" ;;
                esac
                return 0
            fi
        done < "$reg"
    done
    return 1
}

cmd_list() {
    printf "  %-16s %-20s %-10s %s\n" "NAME" "SSH TARGET" "SESSION" "DESCRIPTION"
    printf "  %-16s %-20s %-10s %s\n" "────" "──────────" "───────" "───────────"
    for reg in $(all_registries); do
        [ -f "$reg" ] || continue
        while IFS='|' read -r name ssh session desc; do
            [[ -z "$name" || "$name" == \#* ]] && continue
            printf "  %-16s %-20s %-10s %s\n" "$name" "$ssh" "$session" "$desc"
        done < "$reg"
    done
}

# hosts.conf uses comma-separated fallbacks:
#   fqdn.tailnet.ts.net,ssh-config-alias
# OpenSSH 10+ rejects commas in the hostname, so callers must split.
split_ssh_targets() {
    local ssh_target="$1"
    local target
    local -a targets=()
    IFS=',' read -r -a targets <<< "$ssh_target"
    for target in "${targets[@]}"; do
        target="${target#"${target%%[![:space:]]*}"}"
        target="${target%"${target##*[![:space:]]}"}"
        [[ -n "$target" ]] && printf '%s\n' "$target"
    done
}

# Runs a remote command, trying comma-separated SSH targets in order.
# Returns: 0 = command succeeded, 2 = SSH reached host but command failed
# (e.g. no tmux server), 1 = every SSH target failed to connect (exit 255).
# A non-255 remote status stops fallback — do not burn time on ProxyJump
# after a successful tailnet login.
remote_tmux_cmd() {
    local ssh_target="$1" remote_cmd="$2"
    local target output status
    local timeout="${TMUX_CONNECT_LS_TIMEOUT:-${TMUX_CONNECT_CONNECT_TIMEOUT:-5}}"
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        output=$(ssh -o ConnectTimeout="$timeout" -o BatchMode=yes "$target" "$remote_cmd" 2>/dev/null)
        status=$?
        if [[ "$status" -eq 0 ]]; then
            printf '%s\n' "$output"
            return 0
        fi
        if [[ "$status" -ne 255 ]]; then
            return 2
        fi
    done < <(split_ssh_targets "$ssh_target")
    return 1
}

remote_tmux_sessions() {
    remote_tmux_cmd "$1" "tmux list-sessions -F '#S'"
}

local_tmux_sessions() {
    tmux list-sessions -F '#S' 2>/dev/null
}

cmd_ls() {
    local name="${1:-local}"
    local ssh_target listing names status

    if [[ "$name" == "local" || "$name" == "mac" ]]; then
        if ! listing=$(tmux list-sessions 2>/dev/null); then
            echo "tmux-connect: no local tmux sessions" >&2
            return 1
        fi
        printf '%s\n' "$listing"
        local_tmux_sessions | write_session_cache "local"
        return 0
    fi

    ssh_target=$(get_host_field "$name" "ssh") || {
        echo "Unknown host: $name" >&2
        echo "Run 'tmux-connect --list' to see available hosts" >&2
        return 1
    }

    if [[ "$ssh_target" == "local" ]]; then
        if ! listing=$(tmux list-sessions 2>/dev/null); then
            echo "tmux-connect: no local tmux sessions" >&2
            return 1
        fi
        printf '%s\n' "$listing"
        local_tmux_sessions | write_session_cache "$name"
        local_tmux_sessions | write_session_cache "local"
        return 0
    fi

    if listing=$(remote_tmux_cmd "$ssh_target" "tmux list-sessions"); then
        printf '%s\n' "$listing"
        printf '%s\n' "$listing" | awk -F: '{print $1}' | write_session_cache "$name"
        return 0
    else
        status=$?
        if [[ "$status" -eq 2 ]]; then
            echo "tmux-connect: no attachable sessions on $name" >&2
            : | write_session_cache "$name"
            return 0
        fi
        echo "tmux-connect: could not list sessions on $name" >&2
        return 1
    fi
}

connect_remote() {
    local ssh_target="$1" session="$2"
    local target status=1 remote_cmd
    local -a targets=()

    remote_cmd="tmux new-session -A -s $(printf '%q' "$session")"
    while IFS= read -r target; do
        [[ -n "$target" ]] && targets+=("$target")
    done < <(split_ssh_targets "$ssh_target")

    for target in "${targets[@]}"; do
        if [[ "${#targets[@]}" -gt 1 ]]; then
            echo "Trying SSH target: $target" >&2
        fi
        if ssh -o ConnectTimeout="${TMUX_CONNECT_CONNECT_TIMEOUT:-5}" -t "$target" "$remote_cmd"; then
            return 0
        else
            status=$?
            echo "SSH target failed ($target, exit $status)" >&2
        fi
    done
    return "$status"
}

cmd_status() {
    local name ssh session desc names sessions status
    echo "  Checking host status..."
    echo ""
    printf "  %-16s %-8s %s\n" "HOST" "STATUS" "SESSIONS"
    printf "  %-16s %-8s %s\n" "────" "──────" "────────"

    for reg in $(all_registries); do
        [ -f "$reg" ] || continue
        while IFS='|' read -r name ssh session desc; do
            [[ -z "$name" || "$name" == \#* ]] && continue

            if [[ "$ssh" == "local" ]]; then
                if names=$(local_tmux_sessions); then
                    printf '%s\n' "$names" | write_session_cache "$name"
                    printf '%s\n' "$names" | write_session_cache "local"
                    sessions=$(printf '%s\n' "$names" | tr '\n' ', ' | sed 's/,$//')
                else
                    sessions=""
                fi
                printf "  %-16s %-8s %s\n" "$name" "✅" "${sessions:-none}"
            else
                if names=$(remote_tmux_sessions "$ssh"); then
                    printf '%s\n' "$names" | write_session_cache "$name"
                    sessions=$(printf '%s\n' "$names" | tr '\n' ', ' | sed 's/,$//')
                    printf "  %-16s %-8s %s\n" "$name" "✅" "${sessions:-none}"
                else
                    status=$?
                    if [[ "$status" -eq 2 ]]; then
                        : | write_session_cache "$name"
                        printf "  %-16s %-8s %s\n" "$name" "✅" "none"
                    else
                        printf "  %-16s %-8s %s\n" "$name" "⬚" "-"
                    fi
                fi
            fi
        done < "$reg"
    done
}

connect_host() {
    local name="$1"
    local session="${2:-}"

    local ssh_target
    ssh_target=$(get_host_field "$name" "ssh") || {
        echo "Unknown host: $name"
        echo "Run 'tmux-connect --list' to see available hosts"
        exit 1
    }

    if [[ -z "$session" ]]; then
        session=$(get_host_field "$name" "session")
    fi

    echo "Connecting to $name ($ssh_target) → tmux session: $session"

    if [[ "$ssh_target" == "local" ]]; then
        # Local: attach or create
        if tmux has-session -t "$session" 2>/dev/null; then
            if [[ -n "${TMUX:-}" ]]; then
                tmux switch-client -t "$session"
            else
                tmux attach-session -t "$session"
            fi
        else
            # Check for a layout script
            local layout="${SCRIPT_DIR}/sessions/${session}.sh"
            if [[ -x "$layout" ]]; then
                exec "$layout" "$session"
            else
                tmux new-session -s "$session"
            fi
        fi
    else
        # Remote: SSH with tmux attach-or-create.
        # Comma-separated ssh targets are tried in order (tailnet, then jump).
        connect_remote "$ssh_target" "$session"
    fi
}

cmd_picker() {
    if ! command -v fzf &>/dev/null; then
        echo "fzf not installed — listing hosts instead:"
        echo ""
        cmd_list
        echo ""
        echo "Usage: tmux-connect <host> [session]"
        return
    fi

    local selection
    selection=$(
        while IFS='|' read -r name ssh session desc; do
            [[ -z "$name" || "$name" == \#* ]] && continue
            printf "%-16s  %-20s  %s\n" "$name" "($ssh → $session)" "$desc"
        done < "$REGISTRY" | fzf --prompt="Connect to > " --header="HOST                TARGET                DESCRIPTION" --reverse
    ) || exit 0

    local host
    host=$(echo "$selection" | awk '{print $1}')
    connect_host "$host"
}

# shellcheck source=tmux-connect-sandbox.inc
. "$SCRIPT_DIR/tmux-connect-sandbox.inc"

# Explicit direct-argv execution, distinct from interactive shell initialization.
# Only the short-lived control client is bounded; persistent sessions are never killed.
launch_reject() {
    printf '{"schema":"tmux-connect.launch.v1","creation":"not_attempted","diagnostic":"%s","native_resume_locator":null,"first_response":null}\n' "$1"
}

launch_argv_limits() {
    # C locale makes bash string lengths bytes; keep it local to validation.
    local LC_ALL=C bytes=0 arg
    if [[ "$#" -gt 256 ]]; then
        launch_reject argv_count_limit
        return 2
    fi
    for arg in "$@"; do
        bytes=$((bytes + ${#arg} + 1))
        if [[ "$bytes" -gt 16384 ]]; then
            launch_reject argv_bytes_limit
            return 2
        fi
    done
}

launch_new_argv() {
    case "${TMUX_CONNECT_AGENT_MODE:-0}" in
        0|'') ;;
        *)
            # This base has no agent-custody adapter; never fall back to SSH.
            launch_reject agent_custody_mode_unsupported
            return 2
            ;;
    esac
    launch_argv_limits "$@" || return "$?"
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s\n' '{"schema":"tmux-connect.launch.v1","creation":"not_attempted","diagnostic":"python3_unavailable","native_resume_locator":null,"first_response":null}'
        return 127
    fi
    python3 - "$SCRIPT_DIR/tmux-connect" "$REGISTRY" "$EXTRA_REGISTRIES" "$@" <<'PY'
import hashlib
import json
import os
import re
import selectors
import shlex
import subprocess
import sys
import time

source, registry, extras, mode, *args = sys.argv[1:]
receipt = {
    "schema": "tmux-connect.launch.v1",
    "host": None, "sandbox": None, "session": None, "pane": None,
    "cwd": None, "executable": None, "request_id": None,
    "declared_alias": None, "declared_profile": None, "resolved_home": None,
    "source": {"adapter": "tmux-connect", "interface": "new-argv.v1"},
    "execution": "tmux-direct-argv",
    "interactive_shell_initialized": False,
    "profile": "caller_preserved_unread",
    "model": None, "account": "native_inherited_unverified",
    "creation": "not_attempted", "native_resume_locator": None,
    "first_response": None, "registration": None, "heartbeat": None,
    "attach_argv": None, "exit_code": None, "diagnostic": None,
}
started = time.monotonic()


def finish(code, diagnostic=None):
    receipt["diagnostic"] = diagnostic
    receipt["elapsed_ms"] = round((time.monotonic() - started) * 1000)
    print(json.dumps(receipt, separators=(",", ":")))
    raise SystemExit(code)


def ident(value):
    return bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", value))


def absolute(value):
    return (value.startswith("/") and
            not any(c in value for c in "\x00\r\n*?[]") and
            not any(p in (".", "..") for p in value.split("/")))


def control(argv, deadline):
    # Capture only bounded control output, never a pane transcript or an env dump.
    proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    selector = selectors.DefaultSelector()
    for stream in (proc.stdout, proc.stderr):
        selector.register(stream, selectors.EVENT_READ)
    output = {proc.stdout: bytearray(), proc.stderr: bytearray()}
    size = 0
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                proc.kill()
                return None, b"", b"", "control_timeout"
            for key, _ in selector.select(min(remaining, 0.1)):
                chunk = os.read(key.fileobj.fileno(), 4096)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                size += len(chunk)
                if size > 65536:
                    proc.kill()
                    return None, b"", b"", "control_output_limit"
                output[key.fileobj].extend(chunk)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            proc.kill()
            return None, b"", b"", "control_timeout"
        try:
            status = proc.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            proc.kill()
            return None, b"", b"", "control_timeout"
        return status, bytes(output[proc.stdout]), bytes(output[proc.stderr]), None
    finally:
        selector.close()
        proc.stdout.close()
        proc.stderr.close()
        if proc.poll() is None:
            proc.kill()
        proc.wait()


try:
    count = 3 if mode == "sandbox" else 2
    if len(args) < count + 4:
        finish(2, "invalid_launch_arguments")
    host = args.pop(0)
    box = args.pop(0) if mode == "sandbox" else None
    session = args.pop(0)
    if not ident(host) or not ident(session) or (box is not None and not ident(box)):
        finish(2, "invalid_target_identity")
    receipt.update(host=host, sandbox=box, session=session)
    cwd, request, timeout = None, None, 15
    while args and args[0] != "--":
        flag = args.pop(0)
        if not args or flag not in ("--cwd", "--alias", "--profile", "--request-id", "--timeout"):
            finish(2, "invalid_launch_option")
        value = args.pop(0)
        if flag == "--cwd":
            if cwd is not None or not absolute(value):
                finish(2, "invalid_cwd")
            cwd = value
        elif flag in ("--alias", "--profile"):
            field = "declared_" + flag[2:]
            if receipt[field] is not None or not ident(value):
                finish(2, "invalid_declared_identity")
            receipt[field] = value
        elif flag == "--request-id":
            if request is not None or not ident(value):
                finish(2, "invalid_request_id")
            request = value
        else:
            if not re.fullmatch(r"[0-9]+", value) or not 1 <= int(value) <= 60:
                finish(2, "invalid_timeout")
            timeout = int(value)
    if not args or args.pop(0) != "--" or not args or cwd is None:
        finish(2, "missing_cwd_or_executable")
    executable = args[0]
    if not absolute(executable):
        finish(2, "invalid_executable")
    receipt.update(cwd=cwd, executable=executable, request_id=request)
    with open(source, "rb") as handle:
        receipt["source"]["sha256"] = hashlib.sha256(handle.read()).hexdigest()
    with open(os.path.join(os.path.dirname(source), "tmux-connect-sandbox.inc"), "rb") as handle:
        receipt["source"]["sandbox_sha256"] = hashlib.sha256(handle.read()).hexdigest()
    target = "local" if host in ("local", "mac") else None
    if target is None:
        for path in [registry] + [p for p in extras.split(":") if p]:
            try:
                with open(path, encoding="utf-8") as handle:
                    for line in handle:
                        if not line.strip() or line.lstrip().startswith("#"):
                            continue
                        fields = line.rstrip("\n").split("|")
                        if len(fields) >= 2 and fields[0] == host:
                            target = fields[1]
                            break
            except FileNotFoundError:
                continue
            if target is not None:
                break
    if target is None:
        finish(2, "unknown_registered_host")
    local = target == "local"
    if local and box is None:
        if not os.path.isdir(cwd):
            finish(2, "cwd_unavailable")
        if not os.path.isfile(executable) or not os.access(executable, os.X_OK):
            finish(2, "native_executable_unavailable")
    # Multiple tmux shell-command arguments execute directly. env supplies a
    # second argument even for a launcher with no CLI args; no shell -c is used.
    command = ["tmux", "new-session", "-d", "-s", session, "-c", cwd,
               "-P", "-F", "#{session_name}\t#{pane_id}",
               "/usr/bin/env", "--"] + args
    if box is not None:
        command = ["podman", "exec", box] + command
    if not local:
        # One attempt only, including exit 255: a lost reply can follow creation.
        selected = target.split(",")[0].strip()
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._@:-]*", selected):
            finish(2, "invalid_registered_ssh_target")
        command = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                   "--", selected, shlex.join(command)]
    receipt["creation"] = "unknown"
    status, stdout, stderr, failure = control(command, time.monotonic() + timeout)
    receipt["exit_code"] = status
    if failure:
        finish(1, failure)
    if status:
        if b"duplicate session:" in stderr.lower():
            receipt["creation"] = "collision"
            finish(1, "session_collision")
        finish(1, "transport_or_control_failure" if not local else "control_failure")
    fields = stdout.decode("utf-8", errors="replace").strip().split("\t")
    if len(fields) != 2 or fields[0] != session or not re.fullmatch(r"%[0-9]+", fields[1]):
        finish(1, "unverified_creation_reply")
    receipt.update(creation="created", pane=fields[1])
    receipt["attach_argv"] = (["tmux-connect", "--sandbox", host, box, session]
                              if box else ["tmux-connect", host, session])
    finish(0)
except (OSError, ValueError, subprocess.SubprocessError):
    finish(1, "launcher_dependency_or_control_error")
PY
}


# --- Main ---

case "${1:-}" in
    -h|--help|help)         usage ;;
    -l|--list|list)         cmd_list ;;
    --ls)                   cmd_ls "${2:-local}" ;;
    --ls-cache)             cmd_ls_cache "${2:-local}" ;;
    --new-argv)
        shift
        launch_new_argv host "$@"
        ;;
    --sandbox)
        shift
        sandbox_main "$@"
        ;;
    -s|--status|status)     cmd_status ;;
    "")                     cmd_picker ;;
    *)
        if [[ "${2:-}" == "--new-argv" ]]; then
            launch_new_argv host "$1" "${@:3}"
        elif [[ "${2:-}" == "--ls" ]]; then
            cmd_ls "$1"
        else
            connect_host "$1" "${2:-}"
        fi
        ;;
esac
